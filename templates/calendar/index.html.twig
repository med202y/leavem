{% extends 'base.html.twig' %}

{% block title %}Calendrier des Congés{% endblock %}

{% block stylesheets %}
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
    <link href="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.9/index.global.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.9/index.global.min.js"></script>

    <style>
        .calendar-card {
            transition: transform 0.2s;
        }
        .calendar-card:hover {
            transform: translateY(-3px);
        }
        .fc .fc-toolbar-title {
            font-size: 1.25rem;
        }
        .status-filter {
            transition: all 0.2s ease;
            cursor: pointer;
        }
        .status-filter:hover {
            transform: translateY(-1px);
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        }
        .status-badge {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0.5rem 1rem;
            border-radius: 1rem;
            font-size: 0.875rem;
            font-weight: 500;
            border: 2px solid transparent;
            cursor: pointer;
            transition: all 0.2s ease;
        }
        .status-badge.selected {
            border-color: #0d6efd;
            box-shadow: 0 0 0 0.2rem rgba(13, 110, 253, 0.25);
        }
        .status-en_attente { background-color: #fef3c7; color: #92400e; }
        .status-approuvée { background-color: #d1fae5; color: #065f46; }
        .status-rejetée { background-color: #fee2e2; color: #991b1b; }
        .status-annulée { background-color: #f3f4f6; color: #374151; }
        .status-consommée { background-color: #e0e7ff; color: #3730a3; }
        .status-annulation-en-attente { background-color: #fed7aa; color: #9a3412; }

        .legend {
            display: flex;
            flex-wrap: wrap;
            gap: 0.75rem;
            margin-bottom: 1rem;
        }
        .legend-item {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            font-size: 0.875rem;
        }
        .legend-color {
            width: 16px;
            height: 16px;
            border-radius: 4px;
        }

        .filter-section {
            background: #f8f9fa;
            border-radius: 0.5rem;
            padding: 1rem;
            margin-bottom: 1rem;
        }

        /* Custom tooltip styles */
        .custom-tooltip {
            position: absolute;
            background: rgba(0, 0, 0, 0.8);
            color: white;
            padding: 8px 12px;
            border-radius: 4px;
            font-size: 12px;
            pointer-events: none;
            z-index: 1000;
            max-width: 250px;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
        }
    </style>
{% endblock %}

{% block body %}
    <!-- Bouton menu mobile -->
    <button id="mobile-menu-btn" class="md:hidden fixed top-4 left-4 z-50 bg-indigo-600 text-white p-3 rounded-lg shadow-md">
        <i class="fas fa-bars"></i>
    </button>

    <!-- Barre latérale -->
    <aside id="sidebar" class="fixed inset-y-0 left-0 z-50 w-72 bg-indigo-800 text-white shadow-md hidden md:block">
        <div class="h-full flex flex-col justify-between">
            <div>
                <div class="p-6 text-2xl font-bold">
                    <i class="fas fa-user-circle mr-2"></i> Administration
                </div>
                <nav class="flex-1 p-4">
                    <ul class="space-y-1">
                        {% set menu = [
                            {'label': 'Tableau de bord', 'icon': '🏠', 'url': path('dashboard')},
                            {'label': 'Demander un congé', 'icon': '📄', 'url': path('demande')},
                            {'label': 'Équipe', 'icon': '👥', 'url': path('team')}
                        ] %}

                        {% for item in menu %}
                            <li>
                                <a href="{{ item.url }}" class="flex items-center gap-2 px-4 py-2 rounded hover:bg-white/10 transition-colors">
                                    <span class="text-lg">{{ item.icon }}</span>
                                    <span class="text-sm font-medium">{{ item.label }}</span>
                                </a>
                            </li>
                        {% endfor %}
                    </ul>
                    <div class="pt-4">
                        <p class="text-xs uppercase tracking-wide px-4 mb-2 opacity-60">Compte</p>
                        <a href="{{ path('user_profile') }}" class="flex items-center gap-3 px-4 py-3 rounded-lg hover:bg-white/5 text-white/80">
                            <i class="fas fa-user-cog w-5"></i>
                            <span>Paramètres du profil</span>
                        </a>
                        <a href="#" class="flex items-center gap-3 px-4 py-3 rounded-lg hover:bg-white/5 text-white/80">
                            <i class="fas fa-sign-out-alt w-5"></i>
                            <span>Déconnexion</span>
                        </a>
                    </div>
                </nav>
            </div>
        </div>
    </aside>

    <!-- Contenu principal -->
    <main class="min-h-screen bg-gray-100 md:ml-72 transition-all">
        <div class="container py-4">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h1 class="d-flex align-items-center gap-2">
                    <a href="{{ path('dashboard') }}" class="text-decoration-none text-dark" title="Retour">
                        <i class="bi bi-arrow-left" style="font-size: 1.5rem;"></i>
                    </a>
                    Calendrier des Congés
                </h1>
            </div>

            <!-- Section des filtres -->
            <div class="filter-section">
                <h5 class="mb-3">
                    <i class="bi bi-funnel"></i> Filtrer par statut
                </h5>
                <div class="d-flex flex-wrap gap-2 mb-3">
                    {% for status in statuses %}
                        <label class="status-badge status-{{ status.value|replace({' ': '-'}) }} {% if status.selected %}selected{% endif %}">
                            <input type="checkbox"
                                   class="status-filter d-none"
                                   value="{{ status.value }}"
                                   {% if status.selected %}checked{% endif %}>
                            <span>{{ status.label }}</span>
                        </label>
                    {% endfor %}
                </div>

                <div class="d-flex gap-2">
                    <button id="selectAll" class="btn btn-outline-primary btn-sm">
                        <i class="bi bi-check-all"></i> Tout sélectionner
                    </button>
                    <button id="deselectAll" class="btn btn-outline-secondary btn-sm">
                        <i class="bi bi-x-square"></i> Tout désélectionner
                    </button>
                    <button id="applyFilter" class="btn btn-primary btn-sm">
                        <i class="bi bi-arrow-clockwise"></i> Appliquer les filtres
                    </button>
                </div>
            </div>

            <!-- Légende des couleurs -->
            <div class="legend">
                <div class="legend-item">
                    <div class="legend-color" style="background-color: #fbbf24;"></div>
                    <span>En attente</span>
                </div>
                <div class="legend-item">
                    <div class="legend-color" style="background-color: #10b981;"></div>
                    <span>Approuvée</span>
                </div>
                <div class="legend-item">
                    <div class="legend-color" style="background-color: #ef4444;"></div>
                    <span>Rejetée</span>
                </div>
                <div class="legend-item">
                    <div class="legend-color" style="background-color: #6b7280;"></div>
                    <span>Annulée</span>
                </div>
                <div class="legend-item">
                    <div class="legend-color" style="background-color: #8b5cf6;"></div>
                    <span>Consommée</span>
                </div>
                <div class="legend-item">
                    <div class="legend-color" style="background-color: #f97316;"></div>
                    <span>Annulation en attente</span>
                </div>
            </div>

            <div class="card shadow-sm calendar-card">
                <div class="card-header bg-primary text-white">
                    <i class="bi bi-calendar-event"></i> Vue Globale des Congés
                    <small class="ms-2" id="eventCount"></small>
                </div>
                <div class="card-body">
                    <div id="calendar"></div>
                </div>
            </div>
        </div>

        <!-- Custom tooltip element -->
        <div id="customTooltip" class="custom-tooltip" style="display: none;"></div>
    </main>
{% endblock %}

{% block javascripts %}
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Menu mobile
            const menuBtn = document.getElementById('mobile-menu-btn');
            const sidebar = document.getElementById('sidebar');
            menuBtn?.addEventListener('click', () => sidebar?.classList.toggle('hidden'));

            var calendarEl = document.getElementById('calendar');
            var calendar;
            var tooltip = document.getElementById('customTooltip');

            // Initialisation du calendrier
            function initCalendar(events) {
                if (calendar) {
                    calendar.destroy();
                }

                calendar = new FullCalendar.Calendar(calendarEl, {
                    initialView: 'dayGridMonth',
                    locale: 'fr',
                    firstDay: 1,
                    events: events,
                    eventDisplay: 'block',
                    eventTextColor: 'white',
                    height: 'auto',
                    eventMouseEnter: function(info) {
                        // Create tooltip content
                        const tooltipContent = `
                            <strong>${info.event.extendedProps.userName}</strong><br>
                            <strong>Statut:</strong> ${info.event.extendedProps.statusLabel}<br>
                            <strong>Type:</strong> ${info.event.extendedProps.typeConge}<br>
                            <strong>Début:</strong> ${info.event.start.toLocaleDateString('fr-FR')}<br>
                            <strong>Fin:</strong> ${new Date(info.event.end - 86400000).toLocaleDateString('fr-FR')}<br>
                            ${info.event.extendedProps.motif ? '<strong>Motif:</strong> ' + info.event.extendedProps.motif : ''}
                        `;

                        tooltip.innerHTML = tooltipContent;
                        tooltip.style.display = 'block';

                        // Position the tooltip
                        document.addEventListener('mousemove', positionTooltip);
                    },
                    eventMouseLeave: function(info) {
                        tooltip.style.display = 'none';
                        document.removeEventListener('mousemove', positionTooltip);
                    }
                });

                calendar.render();
                updateEventCount(events.length);
            }

            // Position tooltip function
            function positionTooltip(e) {
                const tooltipRect = tooltip.getBoundingClientRect();
                const viewportWidth = window.innerWidth;
                const viewportHeight = window.innerHeight;

                let left = e.pageX + 10;
                let top = e.pageY + 10;

                // Prevent tooltip from going off-screen
                if (left + tooltipRect.width > viewportWidth) {
                    left = e.pageX - tooltipRect.width - 10;
                }
                if (top + tooltipRect.height > viewportHeight) {
                    top = e.pageY - tooltipRect.height - 10;
                }

                tooltip.style.left = left + 'px';
                tooltip.style.top = top + 'px';
            }

            // Mettre à jour le compteur d'événements
            function updateEventCount(count) {
                document.getElementById('eventCount').textContent = `(${count} congé${count > 1 ? 's' : ''})`;
            }

            // Charger les événements avec les filtres
            function loadEvents() {
                const selectedStatuses = Array.from(document.querySelectorAll('.status-filter:checked'))
                    .map(checkbox => checkbox.value);

                const params = new URLSearchParams();
                selectedStatuses.forEach(status => {
                    params.append('statuses[]', status);
                });

                fetch(`{{ path('app_calendar_events') }}?${params.toString()}`)
                    .then(response => response.json())
                    .then(events => {
                        initCalendar(events);
                    })
                    .catch(error => {
                        console.error('Erreur lors du chargement des événements:', error);
                    });
            }

            // Gestionnaire de changement de filtre
            document.querySelectorAll('.status-filter').forEach(checkbox => {
                checkbox.addEventListener('change', function() {
                    const label = this.closest('.status-badge');
                    if (this.checked) {
                        label.classList.add('selected');
                    } else {
                        label.classList.remove('selected');
                    }
                });
            });

            // Bouton "Tout sélectionner"
            document.getElementById('selectAll').addEventListener('click', function() {
                document.querySelectorAll('.status-filter').forEach(checkbox => {
                    checkbox.checked = true;
                    checkbox.closest('.status-badge').classList.add('selected');
                });
            });

            // Bouton "Tout désélectionner"
            document.getElementById('deselectAll').addEventListener('click', function() {
                document.querySelectorAll('.status-filter').forEach(checkbox => {
                    checkbox.checked = false;
                    checkbox.closest('.status-badge').classList.remove('selected');
                });
            });

            // Bouton "Appliquer les filtres"
            document.getElementById('applyFilter').addEventListener('click', function() {
                loadEvents();
            });

            // Charger les événements initiaux
            initCalendar({{ events|raw }});
        });
    </script>
{% endblock %}
