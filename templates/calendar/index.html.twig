{% extends 'base.html.twig' %}

{% block title %}Calendrier des Congés{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link href="{{ asset('css/sidebar-styles.css') }}" rel="stylesheet">
    <link href="{{ asset('css/calendar-styles.css') }}" rel="stylesheet">
{% endblock %}

{% block body %}
    {% include 'partials/_sidebar.html.twig' %}

    <!-- Contenu principal -->
    <main class="main-content with-sidebar">
        <div class="page-container" style="margin-left: 1.5rem;">
            <div class="calendar-header">
                <h1 class="calendar-page-title">
                    <a href="{{ path('dashboard') }}" class="text-decoration-none text-dark" title="Retour">
                        <i class="bi bi-arrow-left" style="font-size: 1.5rem;"></i>
                    </a>
                    Calendrier des Congés
                </h1>
            </div>

            <!-- Section des filtres -->
            <div class="filter-section card">
                <h5 class="mb-3">
                    <i class="bi bi-funnel"></i> Filtrer par statut
                </h5>
                <div class="filter-controls">
                    {% for status in statuses %}
                        <label class="status-badge bg-{{ status.color|default('secondary') }} {% if status.selected %}selected{% endif %}">
                            <input type="checkbox"
                                   class="status-filter d-none"
                                   value="{{ status.value }}"
                                   {% if status.selected %}checked{% endif %}>
                            <span>{{ status.label }}</span>
                        </label>
                    {% endfor %}
                </div>

                <div class="d-flex gap-2">
                    <button id="selectAll" class="btn btn-outline-primary btn-sm">
                        <i class="bi bi-check-all"></i> Tout sélectionner
                    </button>
                    <button id="deselectAll" class="btn btn-outline-secondary btn-sm">
                        <i class="bi bi-x-square"></i> Tout désélectionner
                    </button>
                    <button id="applyFilter" class="btn btn-primary btn-sm">
                        <i class="bi bi-filter"></i> Appliquer
                    </button>
                </div>
            </div>

            <!-- Dynamic legend based on status colors -->
            <div class="legend">
                {% set legend_colors = {
                    'warning': '#fbbf24',
                    'success': '#10b981',
                    'danger': '#ef4444',
                    'secondary': '#6b7280',
                    'info': '#8b5cf6',
                    'primary': '#3b82f6'
                } %}

                {% for status in statuses %}
                    {% set color_class = status.color|default('secondary') %}
                    {% set hex_color = legend_colors[color_class]|default('#008080') %}
                    <div class="legend-item">
                        <div class="legend-color" style="background-color: {{ hex_color }};"></div>
                        <span>{{ status.label }}</span>
                    </div>
                {% endfor %}
            </div>

            <div class="card shadow-sm calendar-card">
                <div class="card-header bg-primary text-white">
                    <i class="bi bi-calendar-event"></i> Vue Globale des Congés
                    <small class="ms-2" id="eventCount"></small>
                </div>
                <div class="card-body">
                    <div id="calendar"></div>
                </div>
            </div>
        </div>

        <!-- Custom tooltip element -->
        <div id="customTooltip" class="custom-tooltip" style="display: none;"></div>
    </main>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        let calendar = null;
        let tooltip = null;

        // Initialize calendar and listeners
        function initializePage() {
            // Check if Calendar is available
            if (typeof window.Calendar === 'undefined') {
                console.error('FullCalendar not loaded yet, retrying...');
                setTimeout(initializePage, 100);
                return;
            }

            // Menu mobile
            const menuBtn = document.getElementById('mobile-menu-btn');
            const sidebar = document.getElementById('sidebar');
            if (menuBtn && sidebar) {
                menuBtn.addEventListener('click', function() {
                    sidebar.classList.toggle('hidden');
                });
            }

            const calendarEl = document.getElementById('calendar');
            tooltip = document.getElementById('customTooltip');

            if (!calendarEl) return;

            // Load initial events
            const initialEvents = {{ events|raw }};
            initCalendar(initialEvents);
        }

        // Initialisation du calendrier
        function initCalendar(events) {
            const calendarEl = document.getElementById('calendar');
            if (!calendarEl) return;

            if (calendar) {
                calendar.destroy();
            }

            calendar = new window.Calendar(calendarEl, {
                plugins: [window.dayGridPlugin, window.interactionPlugin],
                initialView: 'dayGridMonth',
                locale: 'fr',
                firstDay: 1,
                events: events,
                eventDisplay: 'block',
                eventTextColor: 'white',
                height: 'auto',
                eventMouseEnter: function(info) {
                    const tooltipContent = `
                        <strong>${info.event.extendedProps.userName}</strong><br>
                        <strong>Statut:</strong> ${info.event.extendedProps.statusLabel}<br>
                        <strong>Type:</strong> ${info.event.extendedProps.typeConge}<br>
                        <strong>Début:</strong> ${info.event.start.toLocaleDateString('fr-FR')}<br>
                        <strong>Fin:</strong> ${new Date(info.event.end - 86400000).toLocaleDateString('fr-FR')}<br>
                        ${info.event.extendedProps.motif ? '<strong>Motif:</strong> ' + info.event.extendedProps.motif : ''}
                    `;

                    tooltip.innerHTML = tooltipContent;
                    tooltip.style.display = 'block';
                    document.addEventListener('mousemove', positionTooltip);
                },
                eventMouseLeave: function(info) {
                    tooltip.style.display = 'none';
                    document.removeEventListener('mousemove', positionTooltip);
                }
            });

            calendar.render();
            updateEventCount(events.length);
        }

        // Position tooltip function
        function positionTooltip(e) {
            const tooltipRect = tooltip.getBoundingClientRect();
            const viewportWidth = window.innerWidth;
            const viewportHeight = window.innerHeight;

            let left = e.pageX + 10;
            let top = e.pageY + 10;

            if (left + tooltipRect.width > viewportWidth) {
                left = e.pageX - tooltipRect.width - 10;
            }
            if (top + tooltipRect.height > viewportHeight) {
                top = e.pageY - tooltipRect.height - 10;
            }

            tooltip.style.left = left + 'px';
            tooltip.style.top = top + 'px';
        }

        // Mettre à jour le compteur d'événements
        function updateEventCount(count) {
            const eventCountEl = document.getElementById('eventCount');
            if (eventCountEl) {
                eventCountEl.textContent = `(${count} congé${count > 1 ? 's' : ''})`;
            }
        }

        // Charger les événements avec les filtres
        function loadEvents() {
            const selectedStatuses = Array.from(document.querySelectorAll('.status-filter:checked'))
                .map(checkbox => checkbox.value);

            const params = new URLSearchParams();
            selectedStatuses.forEach(status => {
                params.append('statuses[]', status);
            });

            fetch(`{{ path('app_calendar_events') }}?${params.toString()}`)
                .then(response => response.json())
                .then(events => {
                    initCalendar(events);
                })
                .catch(error => {
                    console.error('Erreur lors du chargement des événements:', error);
                });
        }

        // Event delegation for status filter changes
        document.addEventListener('change', function(e) {
            if (e.target.matches('.status-filter')) {
                const label = e.target.closest('.status-badge');
                if (e.target.checked) {
                    label.classList.add('selected');
                } else {
                    label.classList.remove('selected');
                }
            }
        });

        // Event delegation for buttons
        document.addEventListener('click', function(e) {
            if (e.target.id === 'selectAll' || e.target.closest('#selectAll')) {
                document.querySelectorAll('.status-filter').forEach(function(checkbox) {
                    checkbox.checked = true;
                    checkbox.closest('.status-badge').classList.add('selected');
                });
            }

            if (e.target.id === 'deselectAll' || e.target.closest('#deselectAll')) {
                document.querySelectorAll('.status-filter').forEach(function(checkbox) {
                    checkbox.checked = false;
                    checkbox.closest('.status-badge').classList.remove('selected');
                });
            }

            if (e.target.id === 'applyFilter' || e.target.closest('#applyFilter')) {
                loadEvents();
            }
        });

        // Initialize on page load
        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', initializePage);
        } else {
            initializePage();
        }

        // Re-initialize on Turbo navigation
        document.addEventListener('turbo:load', initializePage);
    </script>
{% endblock %}