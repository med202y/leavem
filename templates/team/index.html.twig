{# templates/team.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Équipe – {{ team ? team.name : 'Pas d’équipe' }}{% endblock %}

{% block stylesheets %}
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
{% endblock %}

{% block body %}
    <!-- Bouton menu mobile -->
    <button id="mobile-menu-btn"
            class="md:hidden fixed top-4 left-4 z-50 bg-indigo-600 text-white p-3 rounded-lg shadow-md">
        <i class="fas fa-bars"></i>
    </button>


    <aside id="sidebar" class="fixed inset-y-0 left-0 z-50 w-72 bg-indigo-800 text-white shadow-md hidden md:block">
        <div class="h-full flex flex-col justify-between">
            <div>
                <div class="p-6 text-2xl font-bold">
                    <i class="fas fa-user-circle mr-2"></i> Espace Utilisateur
                </div>
                <nav class="flex-1 p-4">
                    <ul class="space-y-1">
                        {% set menu = [
                            {'label': 'Tableau de bord', 'icon': '🏠', 'url': path('dashboard')},
                            {'label': 'Demander un congé', 'icon': '📄', 'url': path('request_leave')},
                            {'label': 'Équipe', 'icon': '👥', 'url': path('team')}
                        ] %}

                        {% for item in menu %}
                            <li>
                                <a href="{{ item.url }}" class="flex items-center gap-2 px-4 py-2 rounded hover:bg-white/10 transition-colors">
                                    <span class="text-lg">{{ item.icon }}</span>
                                    <span class="text-sm font-medium">{{ item.label }}</span>
                                </a>
                            </li>
                        {% endfor %}
                    </ul>
                    <div class="pt-4">
                        <p class="text-xs uppercase tracking-wide px-4 mb-2 opacity-60">Compte</p>
                        <a href="{{ path('user_profile') }}" class="flex items-center gap-3 px-4 py-3 rounded-lg hover:bg-white/5 text-white/80">
                            <i class="fas fa-user-cog w-5"></i>
                            <span>Paramètres du profil</span>
                        </a>
                        <a href="{{ path('app_logout') }}" class="flex items-center gap-3 px-4 py-3 rounded-lg hover:bg-white/5 text-white/80">
                            <i class="fas fa-sign-out-alt w-5"></i>
                            <span>Déconnexion</span>
                        </a>
                    </div>
                </nav>
            </div>
        </div>
    </aside>

    <!-- Contenu principal -->
    <main class="min-h-screen bg-gray-100 md:ml-72 transition-all">
        <div class="p-6 max-w-7xl mx-auto">
            {# En-tête #}
            <div class="bg-white rounded-2xl p-6 shadow mb-6 flex justify-between items-center">
                <div>
                    <h1 class="text-3xl font-bold text-indigo-700">
                        Équipe : {{ team ? team.name : '–' }}
                    </h1>
                    {% if team and team.description %}
                        <p class="text-gray-600">{{ team.description }}</p>
                    {% endif %}
                </div>
                <p class="text-sm text-gray-500">
                    {{ "now"|date("l, F j, Y")|trans }}
                </p>
            </div>

            {# Tableau des membres #}
            <div class="bg-white rounded-2xl shadow p-6">
                {% if members|length > 0 %}
                    <div class="overflow-x-auto">
                        <table class="min-w-full table-auto">
                            <thead>
                            <tr class="bg-indigo-100 text-left">
                                <th class="px-4 py-2">Nom</th>
                                <th class="px-4 py-2">Prénom</th>
                                <th class="px-4 py-2">Département</th>
                            </tr>
                            </thead>
                            <tbody>
                            {% for member in members %}
                                <tr class="border-b hover:bg-gray-50">
                                   {# Dans team.html.twig #}
                                    <td class="px-4 py-3 text-gray-800">
                                          {{ member.lastName }} {# Remplacer member.nom #}
                                    </td>
                                    <td class="px-4 py-3 text-gray-800">
                                          {{ member.firstName }} {# Remplacer member.prenom #}
                                    </td> 
                                    <td class="px-4 py-3 text-gray-600">
    {{ member.department.value ?? '–' }} {# Accéder à la valeur de l'énumération #}
</td>
                                </tr>
                            {% endfor %}
                            </tbody>
                        </table>
                    </div>
                {% else %}
                    <p class="text-center text-gray-500">
                        Vous n’appartenez à aucune équipe ou elle est vide.
                    </p>
                {% endif %}
            </div>
            
        </div>
    </main>
{% endblock %}

{% block javascripts %}
    <script>
        const menuBtn = document.getElementById('mobile-menu-btn');
        const sidebar = document.getElementById('sidebar');
        menuBtn?.addEventListener('click', () => sidebar?.classList.toggle('-translate-x-full'));
    </script>
{% endblock %}
