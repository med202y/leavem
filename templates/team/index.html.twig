{# templates/team.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Équipe – {{ team ? team.name : 'Pas d'équipe' }}{% endblock %}

{% block stylesheets %}
{{ parent() }}
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <link href="{{ asset('css/sidebar-styles.css') }}" rel="stylesheet">
    <link href="{{ asset('css/team-styles.css') }}" rel="stylesheet">
{% endblock %}

{% block body %}
    {% include 'partials/_sidebar.html.twig' %}

    <main class="main-content with-sidebar">
        <div class="page-container">
            {# En-tête #}
            <div class="team-header-card">
                <div>
                    <h1 class="team-page-title">
                        Équipe : {{ team ? team.name : '–' }}
                    </h1>
                    {% if team and team.description %}
                        <p class="team-page-description">{{ team.description }}</p>
                    {% endif %}
                </div>
                <p class="team-header-date">
                    {{ "now"|date("l, F j, Y")|trans }}
                </p>
            </div>

            {# Tableau des membres #}
            <div class="table-card">
                {% if members|length > 0 %}
                    <div class="table-wrapper">
                        <table class="team-table">
                            <thead>
                            <tr class="table-header-row">
                                <th class="table-header-cell">Nom</th>
                                <th class="table-header-cell">Prénom</th>
                                <th class="table-header-cell">Département</th>
                            </tr>
                            </thead>
                            <tbody>
                            {% for member in members %}
                                <tr class="table-body-row">
                                    <td class="table-body-cell">
                                        {{ member.lastName }}
                                    </td>
                                    <td class="table-body-cell">
                                        {{ member.firstName }}
                                    </td>
                                    <td class="table-body-cell">
                                        {{ member.department.value ?? '–' }}
                                    </td>
                                </tr>
                            {% endfor %}
                            </tbody>
                        </table>
                    </div>
                {% else %}
                    <p class="table-empty-message">
                        Vous n'appartenez à aucune équipe ou elle est vide.
                    </p>
                {% endif %}
            </div>

        </div>
    </main>
{% endblock %}

{% block javascripts %}
    <script>
        const menuBtn = document.getElementById('mobile-menu-btn');
        const sidebar = document.getElementById('sidebar');
        menuBtn?.addEventListener('click', () => sidebar?.classList.toggle('-translate-x-full'));
    </script>
{% endblock %}
