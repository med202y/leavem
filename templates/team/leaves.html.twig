{# templates/conge/manager_leaves.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Mes Demandes de Congé{% endblock %}

{% block stylesheets %}
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <link href="{{ asset('css/manager-leaves-styles.css') }}" rel="stylesheet">
{% endblock %}

{% block body %}
    <div class="manager-leaves-container">
        <div class="manager-leaves-content">
            <!-- En-tête -->
            <div class="manager-leaves-header">
                <h1 class="manager-leaves-title">
                    <a href="{{ path('dashboard') }}">
                        <i class="fas fa-arrow-left"></i>
                    </a>
                    <span>Mes Demandes de Congé</span>
                </h1>
                <a href="{{ path('request_leave') }}" class="new-request-btn">
                    <i class="fas fa-plus-circle"></i> Nouvelle Demande
                </a>
            </div>

            <!-- Filtres par statut -->
            <div class="status-filters">
                <button class="status-filter active" data-status="all">Tous</button>
                {% for status in statuses %}
                    {% set color = statusColors[status] %}
                    <button class="status-filter {% if color == 'success' %}bg-green-100
                        {% elseif color == 'danger' %}bg-red-100
                        {% elseif color == 'warning' %}bg-yellow-100
                        {% elseif color == 'secondary' %}bg-gray-100
                        {% elseif color == 'info' %}bg-blue-100
                        {% endif %}"
                            data-status="{{ status }}">
                        {{ status|replace({'_': ' '})|title }}
                    </button>
                {% endfor %}
            </div>

            {% if leaves is empty %}
                <div class="empty-state">
                    <i class="fas fa-info-circle"></i>
                    Vous n'avez soumis aucune demande de congé pour le moment.
                </div>
            {% else %}
                <div class="leaves-cards-grid">
                    {% for leave in leaves %}
                        <div class="conge-card" data-status="{{ leave.status.value }}">
                            <header class="card-header-section">
                                <span class="status-badge {% if statusColors[leave.status.value] == 'success' %}bg-green-100 text-green-800
                                    {% elseif statusColors[leave.status.value] == 'danger' %}bg-red-100 text-red-800
                                    {% elseif statusColors[leave.status.value] == 'warning' %}bg-yellow-100 text-yellow-800
                                    {% elseif statusColors[leave.status.value] == 'secondary' %}bg-gray-100 text-gray-800
                                    {% elseif statusColors[leave.status.value] == 'info' %}bg-blue-100 text-blue-800
                                    {% endif %}">
                                    {{ leave.status.value|replace({'_': ' '})|title }}
                                </span>
                                <span class="card-id">#{{ leave.id }}</span>
                            </header>

                            <div class="card-body-section">
                                <h2 class="card-title">
                                    <i class="fas fa-calendar-alt"></i>
                                    {{ leave.leaveType.value|title }}
                                </h2>

                                <div class="date-range">
                                    <div class="date-item">
                                        <small>Du</small>
                                        <span class="font-medium">{{ leave.startDate|date('d M Y') }}</span>
                                    </div>
                                    <i class="fas fa-arrow-right date-arrow"></i>
                                    <div class="date-item">
                                        <small>Au</small>
                                        <span class="font-medium">{{ leave.endDate|date('d M Y') }}</span>
                                    </div>
                                </div>

                                <div class="info-row">
                                    <small>Durée</small>
                                    <span class="font-medium">{{ leave.endDate.diff(leave.startDate).days + 1 }} jours</span>
                                </div>

                                {% if leave.reason %}
                                    <div class="info-row">
                                        <small>Motif</small>
                                        <p>{{ leave.reason }}</p>
                                    </div>
                                {% endif %}

                                <div class="info-row">
                                    <small>Demandé le</small>
                                    <span>{{ leave.requestDate|date('d M Y H:i') }}</span>
                                </div>
                                <div class="info-row">
                                    <small>Demandé par</small>
                                    <span class="font-medium">
                                        {{ leave.user.firstName }} {{ leave.user.lastName }}
                                    </span>
                                </div>
                                {% if leave.processDate %}
                                    <div class="info-row">
                                        <small>Traité le</small>
                                        <span>{{ leave.processDate|date('d M Y H:i') }}</span>
                                    </div>
                                {% endif %}

                                {% if leave.proof %}
                                    <div class="info-row">
                                        <small>Justificatif</small>
                                        <a href="{{ asset('images/' ~ leave.proof) }}" class="btn-outline-primary" download>
                                            <i class="fas fa-download"></i> Télécharger
                                        </a>
                                    </div>
                                {% endif %}

                                {% if leave.refusalReason %}
                                    <div class="info-row">
                                        <small>Raison du refus</small>
                                        <p class="text-red-600">{{ leave.refusalReason }}</p>
                                    </div>
                                {% endif %}
                            </div>

                            <footer class="card-footer-section">
                                <div>
                                    {% if leave.processedBy %}
                                        <small>Traité par : {{ leave.processedBy }}</small>
                                    {% endif %}
                                </div>
                                <div class="action-buttons">
                                    {% if leave.status.value == 'en_attente' %}
                                        <button class="action-btn accept-btn"
                                                data-id="{{ leave.id }}"
                                                data-action="accept"
                                                data-user="{{ leave.user.firstName }} {{ leave.user.lastName }}"
                                                data-type="{{ leave.leaveType.value|title }}"
                                                data-dates="{{ leave.startDate|date('d M Y') }} - {{ leave.endDate|date('d M Y') }}">
                                            <i class="fas fa-check"></i> Accepter
                                        </button>
                                        <button class="action-btn refuse-btn"
                                                data-id="{{ leave.id }}"
                                                data-action="refuse"
                                                data-user="{{ leave.user.firstName }} {{ leave.user.lastName }}"
                                                data-type="{{ leave.leaveType.value|title }}"
                                                data-dates="{{ leave.startDate|date('d M Y') }} - {{ leave.endDate|date('d M Y') }}">
                                            <i class="fas fa-times"></i> Refuser
                                        </button>
                                    {% elseif leave.status.value == 'annulation en attente' %}
                                        <button class="action-btn approve-cancellation-btn"
                                                data-id="{{ leave.id }}"
                                                data-action="approve_cancellation"
                                                data-user="{{ leave.user.firstName }} {{ leave.user.lastName }}"
                                                data-type="{{ leave.leaveType.value|title }}"
                                                data-dates="{{ leave.startDate|date('d M Y') }} - {{ leave.endDate|date('d M Y') }}">
                                            <i class="fas fa-check"></i> Approuver l'annulation
                                        </button>
                                        <button class="action-btn reject-cancellation-btn"
                                                data-id="{{ leave.id }}"
                                                data-action="reject_cancellation"
                                                data-user="{{ leave.user.firstName }} {{ leave.user.lastName }}"
                                                data-type="{{ leave.leaveType.value|title }}"
                                                data-dates="{{ leave.startDate|date('d M Y') }} - {{ leave.endDate|date('d M Y') }}">
                                            <i class="fas fa-times"></i> Rejeter l'annulation
                                        </button>
                                    {% endif %}
                                </div>
                            </footer>
                        </div>
                    {% endfor %}
                </div>
            {% endif %}
        </div>
    </div>

    <!-- Confirmation Modal -->
    <div id="confirmationModal" class="modal-overlay hidden">
        <div class="modal-content">
            <div class="modal-header">
                <!-- Modal Header -->
                <div class="modal-header-content">
                    <div class="modal-icon-wrapper">
                        <div id="confirmationIcon" class="modal-icon"></div>
                        <h3 id="confirmationTitle" class="modal-title"></h3>
                    </div>
                    <button id="closeModal" class="modal-close">
                        <i class="fas fa-times"></i>
                    </button>
                </div>

                <!-- Modal Body -->
                <div class="modal-body">
                    <p id="confirmationMessage" class="modal-message"></p>
                    <div class="modal-details">
                        <div class="modal-details-grid">
                            <div class="modal-details-label">Employé:</div>
                            <div id="confirmUser" class="modal-details-value"></div>
                            <div class="modal-details-label">Type:</div>
                            <div id="confirmType" class="modal-details-value"></div>
                            <div class="modal-details-label">Période:</div>
                            <div id="confirmDates" class="modal-details-value"></div>
                        </div>
                    </div>
                </div>

                <!-- Reason input for refusal -->
                <div id="reasonSection" class="modal-reason-section hidden">
                    <label for="refusalReason" class="modal-reason-label">
                        Raison du refus (optionnel)
                    </label>
                    <textarea id="refusalReason" rows="3" class="modal-reason-input"
                              placeholder="Expliquez pourquoi cette demande est refusée..."></textarea>
                </div>

                <!-- Modal Footer -->
                <div class="modal-footer">
                    <button id="cancelAction" class="modal-btn modal-btn-cancel">
                        <i class="fas fa-times"></i> Annuler
                    </button>
                    <button id="confirmAction" class="modal-btn modal-btn-confirm"></button>
                </div>
            </div>
        </div>
    </div>

    <!-- Success/Error Modal -->
    <div id="alertModal" class="modal-overlay hidden">
        <div class="modal-content">
            <div class="alert-modal-content">
                <div id="alertIcon" class="alert-icon"></div>
                <h3 id="alertTitle" class="alert-title"></h3>
                <p id="alertMessage" class="alert-message"></p>
                <button id="alertOk" class="alert-btn">OK</button>
            </div>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            let currentLeaveId = null;
            let currentAction = null;

            // Modal elements
            const confirmationModal = document.getElementById('confirmationModal');
            const alertModal = document.getElementById('alertModal');

            // Status filtering
            document.querySelectorAll('.status-filter').forEach(btn => {
                btn.addEventListener('click', () => {
                    const status = btn.dataset.status;
                    document.querySelectorAll('.status-filter').forEach(b => b.classList.remove('active'));
                    btn.classList.add('active');

                    document.querySelectorAll('.conge-card').forEach(card => {
                        card.style.display = (status === 'all' || card.dataset.status === status) ? 'block' : 'none';
                    });
                });
            });

            // Show confirmation modal
            function showConfirmationModal(action, leaveData) {
                currentAction = action;
                currentLeaveId = leaveData.id;

                let title = '';
                let message = '';
                let iconHtml = '';
                let iconBg = '';
                let btnText = '';
                let btnClass = '';
                let showReason = false;

                switch (action) {
                    case 'accept':
                        title = 'Accepter la demande';
                        message = 'Êtes-vous sûr de vouloir accepter cette demande de congé ?';
                        iconHtml = '<i class="fas fa-check text-white"></i>';
                        iconBg = 'bg-green-500';
                        btnText = '<i class="fas fa-check mr-2"></i>Accepter';
                        btnClass = 'bg-green-600 hover:bg-green-700';
                        break;
                    case 'refuse':
                        title = 'Refuser la demande';
                        message = 'Êtes-vous sûr de vouloir refuser cette demande de congé ?';
                        iconHtml = '<i class="fas fa-times text-white"></i>';
                        iconBg = 'bg-red-500';
                        btnText = '<i class="fas fa-times mr-2"></i>Refuser';
                        btnClass = 'bg-red-600 hover:bg-red-700';
                        showReason = true;
                        break;
                    case 'approve_cancellation':
                        title = 'Approuver l\'annulation';
                        message = 'Êtes-vous sûr de vouloir approuver cette demande d\'annulation ?';
                        iconHtml = '<i class="fas fa-check text-white"></i>';
                        iconBg = 'bg-green-500';
                        btnText = '<i class="fas fa-check mr-2"></i>Approuver';
                        btnClass = 'bg-green-600 hover:bg-green-700';
                        break;
                    case 'reject_cancellation':
                        title = 'Rejeter l\'annulation';
                        message = 'Êtes-vous sûr de vouloir rejeter cette demande d\'annulation ?';
                        iconHtml = '<i class="fas fa-times text-white"></i>';
                        iconBg = 'bg-red-500';
                        btnText = '<i class="fas fa-times mr-2"></i>Rejeter';
                        btnClass = 'bg-red-600 hover:bg-red-700';
                        break;
                }

                // Set modal content
                document.getElementById('confirmationTitle').textContent = title;
                document.getElementById('confirmationMessage').textContent = message;
                document.getElementById('confirmUser').textContent = leaveData.user;
                document.getElementById('confirmType').textContent = leaveData.type;
                document.getElementById('confirmDates').textContent = leaveData.dates;

                // Set icon and button style
                const icon = document.getElementById('confirmationIcon');
                const confirmBtn = document.getElementById('confirmAction');
                const reasonSection = document.getElementById('reasonSection');

                icon.innerHTML = iconHtml;
                icon.className = `modal-icon ${iconBg}`;
                confirmBtn.innerHTML = btnText;
                confirmBtn.className = `modal-btn modal-btn-confirm ${btnClass}`;

                if (showReason) {
                    reasonSection.classList.remove('hidden');
                } else {
                    reasonSection.classList.add('hidden');
                }

                confirmationModal.classList.remove('hidden');
            }

            // Show alert modal
            function showAlert(title, message, type = 'success') {
                const icon = document.getElementById('alertIcon');
                const titleEl = document.getElementById('alertTitle');
                const messageEl = document.getElementById('alertMessage');

                titleEl.textContent = title;
                messageEl.textContent = message;

                if (type === 'success') {
                    icon.innerHTML = '<i class="fas fa-check text-white text-2xl"></i>';
                    icon.style.backgroundColor = '#10b981';
                } else {
                    icon.innerHTML = '<i class="fas fa-exclamation-triangle text-white text-2xl"></i>';
                    icon.style.backgroundColor = '#ef4444';
                }

                alertModal.classList.remove('hidden');
            }

            // Hide modal with animation
            function hideModal(modal) {
                modal.classList.add('hide');
                setTimeout(() => {
                    modal.classList.add('hidden');
                    modal.classList.remove('hide');
                }, 300);
            }

            // Close modal handlers
            document.getElementById('closeModal').addEventListener('click', () => hideModal(confirmationModal));
            document.getElementById('cancelAction').addEventListener('click', () => hideModal(confirmationModal));
            document.getElementById('alertOk').addEventListener('click', () => {
                hideModal(alertModal);
                if (currentAction) setTimeout(() => location.reload(), 500);
            });

            // Close modals when clicking outside
            [confirmationModal, alertModal].forEach(modal => {
                modal.addEventListener('click', (e) => {
                    if (e.target === modal) hideModal(modal);
                });
            });

            // ESC key to close modals
            document.addEventListener('keydown', (e) => {
                if (e.key === 'Escape') {
                    if (!confirmationModal.classList.contains('hidden')) hideModal(confirmationModal);
                    if (!alertModal.classList.contains('hidden')) hideModal(alertModal);
                }
            });

            // Handle action buttons
            document.querySelectorAll('.action-btn').forEach(button => {
                button.addEventListener('click', () => {
                    const leaveData = {
                        id: button.dataset.id,
                        action: button.dataset.action,
                        user: button.dataset.user,
                        type: button.dataset.type,
                        dates: button.dataset.dates
                    };
                    showConfirmationModal(leaveData.action, leaveData);
                });
            });

            // Confirm action handler
            document.getElementById('confirmAction').addEventListener('click', () => {
                const confirmBtn = document.getElementById('confirmAction');
                const reason = document.getElementById('refusalReason').value;

                confirmBtn.disabled = true;
                confirmBtn.innerHTML = '<i class="fas fa-spinner fa-spin mr-2"></i>Traitement...';

                const formData = new URLSearchParams({ action: currentAction });
                if (currentAction === 'refuse' && reason.trim()) {
                    formData.append('reason', reason.trim());
                }

                fetch(`/manager_leaves/update/${currentLeaveId}`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                        'X-Requested-With': 'XMLHttpRequest'
                    },
                    body: formData
                })
                    .then(async response => {
                        const contentType = response.headers.get('content-type');
                        if (!contentType || !contentType.includes('application/json')) {
                            throw new Error('Réponse non-JSON reçue');
                        }
                        const data = await response.json();
                        if (!response.ok) {
                            const errorTitle = data.title || 'Erreur';
                            const errorMessage = data.detail || 'Une erreur est survenue';
                            throw new Error(`${errorTitle}: ${errorMessage}`);
                        }
                        hideModal(confirmationModal);
                        showAlert('Succès', data.meta?.message || 'Action effectuée avec succès', 'success');
                    })
                    .catch(err => {
                        hideModal(confirmationModal);
                        showAlert('Erreur', err.message || 'Une erreur est survenue lors du traitement', 'error');
                    })
                    .finally(() => {
                        confirmBtn.disabled = false;
                        const isAccept = currentAction === 'accept';
                        confirmBtn.innerHTML = isAccept ? '<i class="fas fa-check mr-2"></i>Accepter' : '<i class="fas fa-times mr-2"></i>Refuser';
                    });
            });
        });
    </script>
{% endblock %}
