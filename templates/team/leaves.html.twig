{# templates/conge/my_leaves.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Mes Demandes de Congé{% endblock %}

{% block stylesheets %}
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        /* Modal animations */
        .modal-overlay {
            animation: fadeIn 0.3s ease-out;
        }
        .modal-content {
            animation: slideUp 0.3s ease-out;
        }
        @keyframes fadeIn {
            from { opacity: 0; }
            to { opacity: 1; }
        }
        @keyframes slideUp {
            from { transform: translateY(1rem); opacity: 0; }
            to { transform: translateY(0); opacity: 1; }
        }
        .modal-overlay.hide {
            animation: fadeOut 0.3s ease-out;
        }
        .modal-content.hide {
            animation: slideDown 0.3s ease-out;
        }
        @keyframes fadeOut {
            from { opacity: 1; }
            to { opacity: 0; }
        }
        @keyframes slideDown {
            from { transform: translateY(0); opacity: 1; }
            to { transform: translateY(1rem); opacity: 0; }
        }
    </style>
{% endblock %}

{% block body %}
    <div class="min-h-screen bg-gray-100 p-6">
        <div class="max-w-4xl mx-auto">
            <!-- En-tête -->
            <div class="flex items-center justify-between mb-6">
                <h1 class="text-3xl font-bold text-indigo-700 flex items-center space-x-2">
                    <a href="{{ path('dashboard') }}" class="text-indigo-500 hover:text-indigo-700">
                        <i class="fas fa-arrow-left"></i>
                    </a>
                    <span>Mes Demandes de Congé</span>
                </h1>
                <a href="{{ path('request_leave') }}"
                   class="inline-flex items-center px-4 py-2 bg-indigo-600 text-white rounded-lg shadow hover:bg-indigo-700 transition">
                    <i class="fas fa-plus-circle mr-2"></i> Nouvelle Demande
                </a>
            </div>

            <!-- Filtres par statut -->
            <div class="flex flex-wrap gap-2 mb-6">
    <button
        class="status-filter px-3 py-1 rounded-full bg-white text-gray-800 border border-gray-300 hover:border-indigo-500 active:border-indigo-500 border font-bold"
        data-status="all">Tous
    </button>
    {% for status in statuses %}
        {% set color = statusColors[status] %}
        <button
            class="status-filter px-3 py-1 rounded-full 
            {% if color == 'success' %}bg-green-100 text-green-800 hover:bg-green-200
            {% elseif color == 'danger' %}bg-red-100 text-red-800 hover:bg-red-200
            {% elseif color == 'warning' %}bg-yellow-100 text-yellow-800 hover:bg-yellow-200
            {% elseif color == 'secondary' %}bg-gray-100 text-gray-800 hover:bg-gray-200
            {% elseif color == 'info' %}bg-blue-100 text-blue-800 hover:bg-blue-200
            {% endif %}"
            data-status="{{ status }}">
            {{ status|replace({'_': ' '})|title }}
        </button>
    {% endfor %}
</div>
            {% if leaves is empty %}
                <div class="bg-white p-4 rounded-lg shadow text-center text-gray-500">
                    <i class="fas fa-info-circle mr-2"></i>
                    Vous n'avez soumis aucune demande de congé pour le moment.
                </div>
            {% else %}
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    {% for leave in leaves %}
                        <div class="conge-card bg-white rounded-2xl shadow hover:shadow-lg transition p-4 flex flex-col justify-between"
                             data-status="{{ leave.status.value }}">
                            <header class="flex justify-between items-center mb-3">
                                <span class="px-2 py-1 rounded-full 
    {% if statusColors[leave.status.value] == 'success' %}bg-green-100 text-green-800
    {% elseif statusColors[leave.status.value] == 'danger' %}bg-red-100 text-red-800
    {% elseif statusColors[leave.status.value] == 'warning' %}bg-yellow-100 text-yellow-800
    {% elseif statusColors[leave.status.value] == 'secondary' %}bg-gray-100 text-gray-800
    {% elseif statusColors[leave.status.value] == 'info' %}bg-blue-100 text-blue-800
    {% endif %} text-sm">
    {{ leave.status.value|replace({'_': ' '})|title }}
</span>
                                <span class="text-gray-400 text-sm">#{{ leave.id }}</span>
                            </header>

                            <div class="mb-4">
                                <h2 class="text-xl font-semibold text-gray-800 mb-2">
                                    <i class="fas fa-calendar-alt mr-1"></i>
                                    {{ leave.leaveType.value|title }}
                                </h2>

                                <div class="flex items-center justify-between text-gray-600 mb-2">
                                    <div>
                                        <small class="block">Du</small>
                                        <span class="font-medium">{{ leave.startDate|date('d M Y') }}</span>
                                    </div>
                                    <i class="fas fa-arrow-right mx-2"></i>
                                    <div>
                                        <small class="block">Au</small>
                                        <span class="font-medium">{{ leave.endDate|date('d M Y') }}</span>
                                    </div>
                                </div>

                                <div class="mb-2">
                                    <small class="block text-gray-600">Durée</small>
                                    <span class="font-medium">{{ leave.endDate.diff(leave.startDate).days + 1 }} jours</span>
                                </div>

                                {% if leave.reason %}
                                    <div class="mb-2">
                                        <small class="block text-gray-600">Motif</small>
                                        <p>{{ leave.reason }}</p>
                                    </div>
                                {% endif %}

                                <div class="mb-2">
                                    <small class="block text-gray-600">Demandé le</small>
                                    <span>{{ leave.requestDate|date('d M Y H:i') }}</span>
                                </div>
                                <div class="mb-2">
                                    <small class="block text-gray-600">Demandé par</small>
                                    <span class="font-medium">
                                        {{ leave.user.firstName }} {{ leave.user.lastName }}
                                    </span>
                                </div>
                                {% if leave.processDate %}
                                    <div>
                                        <small class="block text-gray-600">Traité le</small>
                                        <span>{{ leave.processDate|date('d M Y H:i') }}</span>
                                    </div>
                                {% endif %}

                                {# Download justificatif button #}
                                {% if leave.proof %}
                                    <div class="mb-2">
                                        <small class="block text-gray-600">Justificatif</small>
                                        <a href="{{ asset('images/' ~ leave.proof) }}" class="btn btn-sm btn-outline-primary mt-1" download>
                                            <i class="fas fa-download"></i> Télécharger
                                        </a>
                                    </div>
                                {% endif %}

                                {% if leave.refusalReason %}
                                    <div class="mb-2">
                                        <small class="block text-gray-600">Raison du refus</small>
                                        <p class="text-red-600">{{ leave.refusalReason }}</p>
                                    </div>
                                {% endif %}
                            </div>

                            <footer class="flex items-center justify-between mt-4 pt-4 border-t border-gray-200">
                                <div>
                                    {% if leave.processedBy %}
                                        <small class="text-gray-500">Traité par : {{ leave.processedBy }}</small>
                                    {% endif %}
                                </div>
                                <div class="space-x-2">
                                    {% if leave.status.value == 'en_attente' %}
    <button
        class="action-btn accept-btn px-3 py-1 text-sm rounded-lg bg-green-100 text-green-600 hover:bg-green-200 transition transform hover:scale-105"
        data-id="{{ leave.id }}"
        data-action="accept"
        data-user="{{ leave.user.firstName }} {{ leave.user.lastName }}"
        data-type="{{ leave.leaveType.value|title }}"
        data-dates="{{ leave.startDate|date('d M Y') }} - {{ leave.endDate|date('d M Y') }}">
        <i class="fas fa-check mr-1"></i>
        Accepter
    </button>
    <button
        class="action-btn refuse-btn px-3 py-1 text-sm rounded-lg bg-red-100 text-red-600 hover:bg-red-200 transition transform hover:scale-105"
        data-id="{{ leave.id }}"
        data-action="refuse"
        data-user="{{ leave.user.firstName }} {{ leave.user.lastName }}"
        data-type="{{ leave.leaveType.value|title }}"
        data-dates="{{ leave.startDate|date('d M Y') }} - {{ leave.endDate|date('d M Y') }}">
        <i class="fas fa-times mr-1"></i>
        Refuser
    </button>
{% elseif leave.status.value == 'annulation en attente' %}
    <button
        class="action-btn approve-cancellation-btn px-3 py-1 text-sm rounded-lg bg-green-100 text-green-600 hover:bg-green-200 transition"
        data-id="{{ leave.id }}"
        data-action="approve_cancellation"
        data-user="{{ leave.user.firstName }} {{ leave.user.lastName }}"
        data-type="{{ leave.leaveType.value|title }}"
        data-dates="{{ leave.startDate|date('d M Y') }} - {{ leave.endDate|date('d M Y') }}">
        <i class="fas fa-check mr-1"></i>
        Approuver l'annulation
    </button>
    <button
        class="action-btn reject-cancellation-btn px-3 py-1 text-sm rounded-lg bg-red-100 text-red-600 hover:bg-red-200 transition"
        data-id="{{ leave.id }}"
        data-action="reject_cancellation"
        data-user="{{ leave.user.firstName }} {{ leave.user.lastName }}"
        data-type="{{ leave.leaveType.value|title }}"
        data-dates="{{ leave.startDate|date('d M Y') }} - {{ leave.endDate|date('d M Y') }}">
        <i class="fas fa-times mr-1"></i>
        Rejeter l'annulation
    </button>
{% endif %}

                                </div>
                            </footer>
                        </div>
                    {% endfor %}
                </div>
            {% endif %}
        </div>
    </div>

    <!-- Confirmation Modal -->
    <div id="confirmationModal" class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50 hidden modal-overlay">
        <div class="bg-white rounded-2xl shadow-2xl max-w-md w-full mx-4 modal-content">
            <div class="p-6">
                <!-- Modal Header -->
                <div class="flex items-center justify-between mb-4">
                    <div class="flex items-center space-x-3">
                        <div id="confirmationIcon" class="w-10 h-10 rounded-full flex items-center justify-center">
                            <!-- Icon will be inserted by JavaScript -->
                        </div>
                        <h3 id="confirmationTitle" class="text-lg font-semibold text-gray-900"></h3>
                    </div>
                    <button id="closeModal" class="text-gray-400 hover:text-gray-600 transition">
                        <i class="fas fa-times text-xl"></i>
                    </button>
                </div>

                <!-- Modal Body -->
                <div class="mb-6">
                    <p id="confirmationMessage" class="text-gray-600 mb-4"></p>
                    <div class="bg-gray-50 rounded-lg p-3">
                        <div class="grid grid-cols-2 gap-2 text-sm">
                            <div class="text-gray-500">Employé:</div>
                            <div id="confirmUser" class="font-medium"></div>
                            <div class="text-gray-500">Type:</div>
                            <div id="confirmType" class="font-medium"></div>
                            <div class="text-gray-500">Période:</div>
                            <div id="confirmDates" class="font-medium"></div>
                        </div>
                    </div>
                </div>

                <!-- Reason input for refusal -->
                <div id="reasonSection" class="mb-6 hidden">
                    <label for="refusalReason" class="block text-sm font-medium text-gray-700 mb-2">
                        Raison du refus (optionnel)
                    </label>
                    <textarea
                        id="refusalReason"
                        rows="3"
                        class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent"
                        placeholder="Expliquez pourquoi cette demande est refusée..."></textarea>
                </div>

                <!-- Modal Footer -->
                <div class="flex space-x-3">
                    <button
                        id="cancelAction"
                        class="flex-1 px-4 py-2 bg-gray-100 text-gray-700 rounded-lg hover:bg-gray-200 transition">
                        <i class="fas fa-times mr-2"></i>
                        Annuler
                    </button>
                    <button
                        id="confirmAction"
                        class="flex-1 px-4 py-2 text-white rounded-lg transition transform hover:scale-105">
                        <!-- Content will be set by JavaScript -->
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Success/Error Modal -->
    <div id="alertModal" class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50 hidden modal-overlay">
        <div class="bg-white rounded-2xl shadow-2xl max-w-sm w-full mx-4 modal-content">
            <div class="p-6 text-center">
                <div id="alertIcon" class="w-16 h-16 mx-auto mb-4 rounded-full flex items-center justify-center">
                    <!-- Icon will be inserted by JavaScript -->
                </div>
                <h3 id="alertTitle" class="text-lg font-semibold text-gray-900 mb-2"></h3>
                <p id="alertMessage" class="text-gray-600 mb-6"></p>
                <button
                    id="alertOk"
                    class="w-full px-4 py-2 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 transition">
                    OK
                </button>
            </div>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            let currentLeaveId = null;
            let currentAction = null;

            // Modal elements
            const confirmationModal = document.getElementById('confirmationModal');
            const alertModal = document.getElementById('alertModal');

            // Filtrage par statut
            document.querySelectorAll('.status-filter').forEach(btn => {
                btn.addEventListener('click', () => {
                    const status = btn.dataset.status;
                    document.querySelectorAll('.status-filter').forEach(b => b.classList.remove('border', 'font-bold'));
                    btn.classList.add('border', 'font-bold');

                    document.querySelectorAll('.conge-card').forEach(card => {
                        card.style.display = (status === 'all' || card.dataset.status === status) ? 'block' : 'none';
                    });
                });
            });

            // Show confirmation modal
            function showConfirmationModal(action, leaveData) {
    currentAction = action;
    currentLeaveId = leaveData.id;

    let title = '';
    let message = '';
    let iconHtml = '';
    let iconBg = '';
    let btnText = '';
    let btnClass = '';
    let showReason = false;

    switch (action) {
        case 'accept':
            title = 'Accepter la demande';
            message = 'Êtes-vous sûr de vouloir accepter cette demande de congé ?';
            iconHtml = '<i class="fas fa-check text-white"></i>';
            iconBg = 'bg-green-500';
            btnText = '<i class="fas fa-check mr-2"></i>Accepter';
            btnClass = 'bg-green-600 hover:bg-green-700';
            break;
        case 'refuse':
            title = 'Refuser la demande';
            message = 'Êtes-vous sûr de vouloir refuser cette demande de congé ?';
            iconHtml = '<i class="fas fa-times text-white"></i>';
            iconBg = 'bg-red-500';
            btnText = '<i class="fas fa-times mr-2"></i>Refuser';
            btnClass = 'bg-red-600 hover:bg-red-700';
            showReason = true;
            break;
        case 'approve_cancellation':
            title = 'Approuver l\'annulation';
            message = 'Êtes-vous sûr de vouloir approuver cette demande d\'annulation ?';
            iconHtml = '<i class="fas fa-check text-white"></i>';
            iconBg = 'bg-green-500';
            btnText = '<i class="fas fa-check mr-2"></i>Approuver';
            btnClass = 'bg-green-600 hover:bg-green-700';
            break;
        case 'reject_cancellation':
            title = 'Rejeter l\'annulation';
            message = 'Êtes-vous sûr de vouloir rejeter cette demande d\'annulation ?';
            iconHtml = '<i class="fas fa-times text-white"></i>';
            iconBg = 'bg-red-500';
            btnText = '<i class="fas fa-times mr-2"></i>Rejeter';
            btnClass = 'bg-red-600 hover:bg-red-700';
            break;
    }

    // Set modal content
    document.getElementById('confirmationTitle').textContent = title;
    document.getElementById('confirmationMessage').textContent = message;
    document.getElementById('confirmUser').textContent = leaveData.user;
    document.getElementById('confirmType').textContent = leaveData.type;
    document.getElementById('confirmDates').textContent = leaveData.dates;

    // Set icon and button style
    const icon = document.getElementById('confirmationIcon');
    const confirmBtn = document.getElementById('confirmAction');
    const reasonSection = document.getElementById('reasonSection');

    icon.innerHTML = iconHtml;
    icon.className = `w-10 h-10 rounded-full flex items-center justify-center ${iconBg}`;
    confirmBtn.innerHTML = btnText;
    confirmBtn.className = `flex-1 px-4 py-2 text-white rounded-lg transition transform hover:scale-105 ${btnClass}`;

    if (showReason) {
        reasonSection.classList.remove('hidden');
    } else {
        reasonSection.classList.add('hidden');
    }

    confirmationModal.classList.remove('hidden');
}


            // Show alert modal
            function showAlert(title, message, type = 'success') {
                const icon = document.getElementById('alertIcon');
                const titleEl = document.getElementById('alertTitle');
                const messageEl = document.getElementById('alertMessage');

                titleEl.textContent = title;
                messageEl.textContent = message;

                if (type === 'success') {
                    icon.innerHTML = '<i class="fas fa-check text-white text-2xl"></i>';
                    icon.className = 'w-16 h-16 mx-auto mb-4 rounded-full flex items-center justify-center bg-green-500';
                } else {
                    icon.innerHTML = '<i class="fas fa-exclamation-triangle text-white text-2xl"></i>';
                    icon.className = 'w-16 h-16 mx-auto mb-4 rounded-full flex items-center justify-center bg-red-500';
                }

                alertModal.classList.remove('hidden');
            }

            // Hide modal with animation
            function hideModal(modal) {
                const overlay = modal.querySelector('.modal-overlay') || modal;
                const content = modal.querySelector('.modal-content');

                overlay.classList.add('hide');
                if (content) content.classList.add('hide');

                setTimeout(() => {
                    modal.classList.add('hidden');
                    overlay.classList.remove('hide');
                    if (content) content.classList.remove('hide');
                }, 300);
            }

            // Close modal handlers
            document.getElementById('closeModal').addEventListener('click', () => {
                hideModal(confirmationModal);
            });

            document.getElementById('cancelAction').addEventListener('click', () => {
                hideModal(confirmationModal);
            });

            document.getElementById('alertOk').addEventListener('click', () => {
                hideModal(alertModal);
                if (currentAction) {
                    setTimeout(() => location.reload(), 500);
                }
            });

            // Close modals when clicking outside
            [confirmationModal, alertModal].forEach(modal => {
                modal.addEventListener('click', (e) => {
                    if (e.target === modal) {
                        hideModal(modal);
                    }
                });
            });

            // ESC key to close modals
            document.addEventListener('keydown', (e) => {
                if (e.key === 'Escape') {
                    if (!confirmationModal.classList.contains('hidden')) {
                        hideModal(confirmationModal);
                    }
                    if (!alertModal.classList.contains('hidden')) {
                        hideModal(alertModal);
                    }
                }
            });

            // Handle action buttons
            document.querySelectorAll('.action-btn').forEach(button => {
                button.addEventListener('click', () => {
                    const leaveData = {
                        id: button.dataset.id,
                        action: button.dataset.action,
                        user: button.dataset.user,
                        type: button.dataset.type,
                        dates: button.dataset.dates
                    };

                    showConfirmationModal(leaveData.action, leaveData);
                });
            });

            // Confirm action handler
            document.getElementById('confirmAction').addEventListener('click', () => {
                const confirmBtn = document.getElementById('confirmAction');
                const reason = document.getElementById('refusalReason').value;

                // Show loading state
                confirmBtn.disabled = true;
                confirmBtn.innerHTML = '<i class="fas fa-spinner fa-spin mr-2"></i>Traitement...';

                // Prepare request body
                const formData = new URLSearchParams({ action: currentAction });
                if (currentAction === 'refuse' && reason.trim()) {
                    formData.append('reason', reason.trim());
                }

                fetch(`/manager_leaves/update/${currentLeaveId}`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                        'X-Requested-With': 'XMLHttpRequest'
                    },
                    body: formData
                })
                    .then(res => {
                        if (!res.ok) throw new Error(res.statusText);
                        return res.json();
                    })
                    .then(data => {
                        hideModal(confirmationModal);

                       if (data.status === 'ok') {
    showAlert('Succès', data.message, 'success');
} else {
    showAlert('Erreur', data.message || 'Impossible de mettre à jour.', 'error');
}

                    })
                    .catch(err => {
                        hideModal(confirmationModal);
                        showAlert('Erreur', `Erreur réseau : ${err.message}`, 'error');
                    })
                    .finally(() => {
                        // Reset button state
                        confirmBtn.disabled = false;
                        const isAccept = currentAction === 'accept';
                        confirmBtn.innerHTML = isAccept
                            ? '<i class="fas fa-check mr-2"></i>Accepter'
                            : '<i class="fas fa-times mr-2"></i>Refuser';
                    });
            });
        });
    </script>
{% endblock %}
