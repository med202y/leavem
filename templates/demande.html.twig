{% extends 'base.html.twig' %}

{% block title %}Gestion des Congés - {{ user.prenom }} {{ user.nom }}{% endblock %}

{% block stylesheets %}
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        .form-label {
            @apply block text-sm font-medium text-gray-700 mb-1;
        }
        .form-input {
            @apply mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm;
        }
        .form-section {
            @apply bg-white shadow rounded-lg p-6 mb-6;
        }
    </style>
{% endblock %}

{% block body %}
    <!-- Bouton menu mobile -->
    <button id="mobile-menu-btn" class="md:hidden fixed top-4 left-4 z-50 bg-indigo-600 text-white p-3 rounded-lg shadow-md">
        <i class="fas fa-bars"></i>
    </button>

    <!-- Barre latérale -->
    <aside id="sidebar" class="sidebar fixed top-0 left-0 h-full w-72 z-50 bg-gradient-to-br from-indigo-600 to-purple-700 text-white transform transition-transform duration-300 md:translate-x-0 -translate-x-full md:block">
        <!-- Sidebar content from your original template -->
        <!-- ... -->
    </aside>

    <!-- Contenu principal -->
    <main class="min-h-screen bg-gray-100 md:ml-72 transition-all">
        <div class="p-6 max-w-7xl mx-auto">
            <!-- En-tête -->
            <div class="bg-white rounded-2xl p-6 shadow mb-6">
                <div class="flex justify-between items-center flex-wrap gap-4">
                    <div>
                        <h1 class="text-3xl font-bold text-indigo-700">Formulaire de Gestion des Congés</h1>
                        <p class="text-gray-600">Remplissez les informations relatives aux congés du salarié</p>
                    </div>
                </div>
            </div>

            <!-- Formulaire -->
            <form method="POST" enctype="multipart/form-data">
            <!-- Section Informations de base -->
            <div class="form-section">
                <h2 class="text-xl font-semibold text-gray-800 mb-4 border-b pb-2">
                    <i class="fas fa-user mr-2"></i>Informations du Salarié
                </h2>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <!-- Colonne 1 -->
                    <div class="space-y-4">
                        <div>
                            <label class="form-label">Nom</label>
                            <p class="mt-1 text-sm text-gray-900 bg-gray-50 p-2 rounded">{{ user.nom }}</p>
                        </div>

                        <div>
                            <label class="form-label">Prénom</label>
                            <p class="mt-1 text-sm text-gray-900 bg-gray-50 p-2 rounded">{{ user.prenom }}</p>
                        </div>

                        <div>
                            <label class="form-label">CIN</label>
                            <p class="mt-1 text-sm text-gray-900 bg-gray-50 p-2 rounded">{{ user.cin }}</p>
                        </div>

                        <div>
                            <label class="form-label">Numéro CNSS</label>
                            <p class="mt-1 text-sm text-gray-900 bg-gray-50 p-2 rounded">{{ user.cnss }}</p>
                        </div>
                    </div>

                    <!-- Colonne 2 -->
                    <div class="space-y-4">
                        <div>
                            <label for="date_embauche" class="form-label">Date d'embauche</label>
                            <p class="mt-1 text-sm text-gray-900 bg-gray-50 p-2 rounded">{{ user.dateDembauche|date('Y-m-d') }}</p>
                        </div>

                        <div>
                            <label class="form-label">Salaire mensuel</label>
                            <p class="mt-1 text-sm text-gray-900 bg-gray-50 p-2 rounded">{{ user.salaireM }}</p>
                        </div>

                        <div>
                            <label for="poste" class="form-label">Poste / Fonction</label>
                            <p class="mt-1 text-sm text-gray-900 bg-gray-50 p-2 rounded">{{ user.departement.value }}</p>
                        </div>

                        <div>
                            <label class="form-label">Qualifications professionnelles</label>
                            <p class="mt-1 text-sm text-gray-900 bg-gray-50 p-2 rounded">{{ user.qualificationsprofessionnelles }}</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Section Gestion des congés -->
            <div class="form-section">
                <h2 class="text-xl font-semibold text-gray-800 mb-4 border-b pb-2">
                    <i class="fas fa-calendar-alt mr-2"></i>Gestion des Congés
                </h2>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <!-- Colonne 1 -->
                    <div class="space-y-4">
                        <div>
                            <label class="form-label">Nombre de jours effectivement travaillés</label>
                            <p class="mt-1 text-sm text-gray-900 bg-gray-50 p-2 rounded">{{ user.nbrDeJoursTravaille }}</p>
                        </div>

                        <div>
                            <label class="form-label">Jours travaillés ouvrant droit à congé</label>
                            <p class="mt-1 text-sm text-gray-900 bg-gray-50 p-2 rounded">{{ user.jourdecongeTravail }}</p>
                        </div>

                        <div>
                            <label class="form-label">Date d'ouverture du droit au congé</label>
                            <p class="mt-1 text-sm text-gray-900 bg-gray-50 p-2 rounded">{{ user.dateDouvertureDroitAuConge|date('Y-m-d') }}</p>
                        </div>
                    </div>

                    <!-- Colonne 2 -->
                    <div class="space-y-4">
                        <div>
                            <label class="form-label">Solde de congés (jours disponibles)</label>
                            <p class="mt-1 text-sm text-gray-900 bg-gray-50 p-2 rounded">{{ user.soldeConge }}</p>
                        </div>
                         <div>
                              <label for="type_conge" class="form-label">Type de congé</label>
                              <select id="type_conge" name="type_conge" class="form-input" required>
                                <option value="">-- Sélectionnez --</option>
                                <option value="congé annuel">Congé annuel</option>
                                <option value="congé exceptionnel">Congé exceptionnel</option>
                                <option value="permission d'absence">Permission d'absence</option>
                                <option value="maladie courte durée">Maladie courte durée</option>
                                <option value="maladie moyenne/longue durée">Maladie moyenne/longue durée</option>
                                <option value="accident du travail">Accident du travail</option>
                                <option value="congé maternité">Congé maternité</option>
                                <option value="congé sans solde">Congé sans solde</option>
                            </select>
                         </div>

                        <div>
                            <label for="date_debut_conge" class="form-label">Date de début du congé</label>
                            <input type="date" id="date_debut_conge" name="date_debut_conge" class="form-input">
                        </div>

                        <div>
                            <label for="date_fin_conge" class="form-label">Date de fin du congé</label>
                            <input type="date" id="date_fin_conge" name="date_fin_conge" class="form-input">
                        </div>
                                            <div class="mt-6 grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div>
                            <label for="date_retour" class="form-label">Date de retour de congé</label>
                            <input type="date" id="date_retour" name="date_retour" class="form-input">
                        </div>
                    </div>
                    </div>
                </div>


                    <!-- Durée et observations -->


                    <div class="mt-6">
                        <label for="observations" class="form-label">Observations</label>
                        <textarea id="observations" name="observations" rows="2" class="form-input resize-none rounded-md p-2 text-sm border border-black" style="max-width: 400px; min-width: 100px; height: 30px;"></textarea>
                    </div>

                    <!-- Justificatif -->
                    <div class="mt-6">
                        <label for="justificatif" class="form-label">Justificatif (optionnel)</label>
                        <div class="flex items-center gap-4">
                            <input type="file" id="justificatif" name="justificatif" accept="image/*" class="form-input">
                            <button type="button" onclick="document.getElementById('justificatif').click()" class="px-4 py-2 border border-indigo-600 rounded-md shadow-sm text-sm font-medium text-indigo-600 bg-white hover:bg-indigo-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">
                                Télécharger
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Boutons de soumission -->
                <div class="flex justify-end gap-4">
                    <button type="reset" class="px-4 py-2 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">
                        Annuler
                    </button>
                    <button type="submit" class="px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">
                        Enregistrer
                    </button>
                </div>
            </form>
        </div>
    </main>
{% endblock %}

{% block javascripts %}
    <script>
        const menuBtn = document.getElementById('mobile-menu-btn');
        const sidebar = document.getElementById('sidebar');
        menuBtn?.addEventListener('click', () => sidebar?.classList.toggle('-translate-x-full'));

        // Calcul automatique de la durée du congé
        const dateDebutInput = document.getElementById('date_debut_conge');
        const dateFinInput = document.getElementById('date_fin_conge');
        const dureeInput = document.getElementById('duree_conge');

        function calculateDuration() {
            if (dateDebutInput.value && dateFinInput.value) {
                const startDate = new Date(dateDebutInput.value);
                const endDate = new Date(dateFinInput.value);

                // Calcul de la différence en jours
                const diffTime = Math.abs(endDate - startDate);
                const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24)) + 1;

                dureeInput.value = diffDays;
            }
        }

        dateDebutInput.addEventListener('change', calculateDuration);
        dateFinInput.addEventListener('change', calculateDuration);
    </script>
{% endblock %}
