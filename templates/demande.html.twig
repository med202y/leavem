{% extends 'base.html.twig' %}

{% block title %}Gestion des Congés - {{ user.prenom }} {{ user.nom }}{% endblock %}

{% block stylesheets %}
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>

{% endblock %}

{% block body %}
    <!-- Bouton menu mobile -->
    <button id="mobile-menu-btn" class="md:hidden fixed top-4 left-4 z-50 bg-indigo-600 text-white p-3 rounded-lg shadow-md">
        <i class="fas fa-bars"></i>
    </button>

    <!-- Barre latérale -->
    <aside id="sidebar" class="fixed inset-y-0 left-0 z-50 w-72 bg-indigo-800 text-white shadow-md hidden md:block">
        <div class="h-full flex flex-col justify-between">
            <div>
                <div class="p-6 text-2xl font-bold">
                    <i class="fas fa-user-circle mr-2"></i> Espace Utilisateur
                </div>
                <nav class="flex-1 p-4">
                    <ul class="space-y-1">
                        {% set menu = [
                            {'label': 'Tableau de bord', 'icon': '🏠', 'url': path('dashboard')},
                            {'label': 'Demander un congé', 'icon': '📄', 'url': path('demande')},
                            {'label': 'Équipe', 'icon': '👥', 'url': path('team')}
                        ] %}

                        {% for item in menu %}
                            <li>
                                <a href="{{ item.url }}" class="flex items-center gap-2 px-4 py-2 rounded hover:bg-white/10 transition-colors">
                                    <span class="text-lg">{{ item.icon }}</span>
                                    <span class="text-sm font-medium">{{ item.label }}</span>
                                </a>
                            </li>
                        {% endfor %}
                    </ul>
                    <div class="pt-4">
                        <p class="text-xs uppercase tracking-wide px-4 mb-2 opacity-60">Compte</p>
                        <a href="{{ path('user_profile') }}" class="flex items-center gap-3 px-4 py-3 rounded-lg hover:bg-white/5 text-white/80">
                            <i class="fas fa-user-cog w-5"></i>
                            <span>Paramètres du profil</span>
                        </a>
                        <a href="#" class="flex items-center gap-3 px-4 py-3 rounded-lg hover:bg-white/5 text-white/80">
                            <i class="fas fa-sign-out-alt w-5"></i>
                            <span>Déconnexion</span>
                        </a>
                    </div>
                </nav>
            </div>
        </div>
    </aside>

    <!-- Contenu principal -->
    <main class="min-h-screen bg-gray-100 md:ml-72 transition-all">
        <div class="p-6 max-w-7xl mx-auto">
            <!-- En-tête -->
            <div class="bg-white rounded-2xl p-6 shadow mb-6">
                <div class="flex justify-between items-center flex-wrap gap-4">
                    <div>
                        <h1 class="text-2xl md:text-3xl font-bold text-indigo-700">Formulaire de Gestion des Congés</h1>
                        <p class="text-gray-600 mt-2">Remplissez les informations relatives aux congés du salarié</p>
                    </div>
                    <div class="text-right hidden md:block">
                        <p class="text-sm text-gray-500">{{ "now"|date("l, F j, Y")|trans }}</p>
                    </div>
                </div>
            </div>

            <!-- Formulaire -->
            <form method="POST" enctype="multipart/form-data" class="space-y-6">
                <!-- Section Informations de base -->
                <div class="form-section">
                    <h2 class="text-xl font-semibold text-gray-800 mb-4 border-b pb-2 flex items-center">
                        <i class="fas fa-user mr-2 text-indigo-600"></i>Informations du Salarié
                    </h2>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <!-- Colonne 1 -->
                        <div class="space-y-4">
                            <div>
                                <label class="form-label">Nom</label>
                                <p class="info-display">{{ user.nom }}</p>
                            </div>

                            <div>
                                <label class="form-label">Prénom</label>
                                <p class="info-display">{{ user.prenom }}</p>
                            </div>
                        </div>

                        <!-- Colonne 2 -->
                        <div class="space-y-4">
                            <div>
                                <label class="form-label">Poste / Fonction</label>
                                <p class="info-display">{{ user.departement.value }}</p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Section Gestion des congés -->
                <div class="form-section">
                    <h2 class="text-xl font-semibold text-gray-800 mb-4 border-b pb-2 flex items-center">
                        <i class="fas fa-calendar-alt mr-2 text-indigo-600"></i>Gestion des Congés
                    </h2>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <!-- Colonne 1 -->
                        <div class="space-y-4">
                            <div>
                                <label class="form-label">Solde de congés (jours disponibles)</label>
                                <p class="info-display">{{ user.soldeConge }} jours</p>
                            </div>
                        </div>

                        <!-- Colonne 2 -->
                        <div class="space-y-4">
                            <div>
                                <label for="type_conge" class="form-label">Type de congé</label>
                                <select id="type_conge" name="type_conge" class="form-input" required>
                                    <option value="">-- Sélectionnez --</option>
                                    <option value="congé annuel">Congé annuel</option>
                                    <option value="congé exceptionnel">Congé exceptionnel</option>
                                    <option value="permission d'absence">Permission d'absence</option>
                                    <option value="maladie courte durée">Maladie courte durée</option>
                                    <option value="maladie moyenne/longue durée">Maladie moyenne/longue durée</option>
                                    <option value="accident du travail">Accident du travail</option>
                                    <option value="congé maternité">Congé maternité</option>
                                    <option value="congé sans solde">Congé sans solde</option>
                                </select>
                            </div>

                            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                <div>
                                    <label for="date_debut_conge" class="form-label">Date de début</label>
                                    <input type="date" id="date_debut_conge" name="date_debut_conge" class="form-input" required>
                                </div>
                                <div>
                                    <label for="date_fin_conge" class="form-label">Date de fin</label>
                                    <input type="date" id="date_fin_conge" name="date_fin_conge" class="form-input" required>
                                </div>
                            </div>

                            <div>
                                <label for="date_retour" class="form-label">Date de retour</label>
                                <input type="date" id="date_retour" name="date_retour" class="form-input">
                            </div>
                        </div>
                    </div>

                    <!-- Observations et justificatif -->
                    <div class="mt-6 grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div>
                            <label for="observations" class="form-label">Observations</label>
                            <textarea id="observations" name="observations" rows="3" class="form-input"></textarea>
                        </div>

                        <div>
                            <label for="justificatif" class="form-label">Justificatif (optionnel)</label>
                            <div class="mt-1 flex rounded-md shadow-sm">
                                <input type="file" id="justificatif" name="justificatif" accept=".pdf,.jpg,.png" class="hidden">
                                <input type="text" id="justificatif-text" readonly class="form-input rounded-r-none flex-1">
                                <button type="button" onclick="document.getElementById('justificatif').click()" class="inline-flex items-center px-4 py-2 border border-l-0 border-gray-300 bg-gray-50 text-gray-700 hover:bg-gray-100 focus:outline-none focus:ring-1 focus:ring-indigo-500 focus:border-indigo-500">
                                    <i class="fas fa-upload mr-2"></i> Parcourir
                                </button>
                            </div>
                            <p class="mt-1 text-xs text-gray-500">Formats acceptés: PDF, JPG, PNG (max 5MB)</p>
                        </div>
                    </div>
                </div>

                <!-- Boutons de soumission -->
                <div class="flex justify-end gap-4 pt-4">
                    <button type="reset" class="action-btn bg-white border border-gray-300 text-gray-700 hover:bg-gray-50 focus:ring-indigo-500">
                        Annuler
                    </button>
                    <button type="submit" class="action-btn bg-indigo-600 text-white hover:bg-indigo-700 focus:ring-indigo-500">
                        <i class="fas fa-save mr-2"></i> Enregistrer
                    </button>
                </div>
            </form>
        </div>
    </main>
{% endblock %}

{% block javascripts %}
    <script>
        // Menu mobile
        const menuBtn = document.getElementById('mobile-menu-btn');
        const sidebar = document.getElementById('sidebar');
        menuBtn?.addEventListener('click', () => sidebar?.classList.toggle('hidden'));

        // Gestion du fichier justificatif
        document.getElementById('justificatif').addEventListener('change', function(e) {
            const fileName = e.target.files[0]?.name || 'Aucun fichier sélectionné';
            document.getElementById('justificatif-text').value = fileName;
        });

        // Calcul automatique de la date de retour
        const dateFinInput = document.getElementById('date_fin_conge');
        const dateRetourInput = document.getElementById('date_retour');

        dateFinInput.addEventListener('change', function() {
            if (dateFinInput.value && !dateRetourInput.value) {
                const dateFin = new Date(dateFinInput.value);
                dateFin.setDate(dateFin.getDate() + 1); // Ajoute 1 jour
                dateRetourInput.valueAsDate = dateFin;
            }
        });

        // Validation des dates
        document.querySelector('form').addEventListener('submit', function(e) {
            const dateDebut = new Date(document.getElementById('date_debut_conge').value);
            const dateFin = new Date(document.getElementById('date_fin_conge').value);

            if (dateDebut > dateFin) {
                alert('La date de fin doit être postérieure à la date de début');
                e.preventDefault();
            }
        });
    </script>
{% endblock %}
