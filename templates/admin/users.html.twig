{# templates/admin/users.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Gestion des utilisateurs{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js"></script>
    <style>
        /* Custom styles for form validation errors */
        .form-error {
            color: #dc3545;
            font-size: 0.875rem;
            margin-top: 0.25rem;
        }
        .form-control.is-invalid {
            border-color: #dc3545;
        }
        /* Sidebar animation */
        .sidebar-transition {
            transition: transform 0.3s ease-in-out;
        }
        /* Modal z-index fix */
        .modal {
            z-index: 1055;
        }
        .modal-backdrop {
            z-index: 1050;
        }
    </style>
{% endblock %}

{% block body %}
    {% include 'partials/_sidebar.html.twig' %}

    <!-- Main Content -->
    <main class="min-h-screen bg-gray-100 md:ml-72">
        <div class="p-6 max-w-7xl mx-auto">
            <!-- Flash Messages -->
            {% for type, messages in app.flashes %}
                {% for message in messages %}
                    <div class="alert alert-{{ type == 'error' ? 'danger' : type }} alert-dismissible fade show mb-4" role="alert">
                        {{ message }}
                        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                            <span aria-hidden="true">&times;</span>
                        </button>
                    </div>
                {% endfor %}
            {% endfor %}

            <!-- Header with Title and Actions -->
            <div class="bg-white rounded-2xl p-6 shadow mb-6 flex justify-between items-center">
                <h1 class="text-3xl font-bold text-indigo-700">Gestion des utilisateurs</h1>
                <div class="flex items-center gap-4">
                    <button type="button" class="bg-indigo-600 hover:bg-indigo-700 text-white px-4 py-2 rounded-lg shadow flex items-center gap-2" data-toggle="modal" data-target="#createUserModal">
                        <i class="fas fa-plus"></i>
                        Ajouter un utilisateur
                    </button>
                    <p class="text-sm text-gray-500">{{ "now"|date("l, F j, Y")|trans }}</p>
                </div>
            </div>

            <!-- Users Table -->
            <div class="bg-white rounded-2xl shadow p-6 overflow-x-auto">
                {% if users|length > 0 %}
                    <table class="min-w-full table-auto">
                        <thead class="bg-indigo-100">
                        <tr>
                            <th class="px-4 py-2 text-left">Nom</th>
                            <th class="px-4 py-2 text-left">Prénom</th>
                            <th class="px-4 py-2 text-left">Email</th>
                            <th class="px-4 py-2 text-left">Département</th>
                            <th class="px-4 py-2 text-left">Rôle(s)</th>
                            <th class="px-4 py-2 text-left">Équipe</th>
                            <th class="px-4 py-2 text-left">Solde</th>
                            <th class="px-4 py-2 text-left">Date Embauche</th>
                            <th class="px-4 py-2 text-left">Actions</th>
                        </tr>
                        </thead>
                        <tbody>
                        {% for user in users %}
                            <tr class="border-b hover:bg-gray-50">
                                <td class="px-4 py-3">{{ user.lastName }}</td>
                                <td class="px-4 py-3">{{ user.firstName }}</td>
                                <td class="px-4 py-3">{{ user.email }}</td>
                                <td class="px-4 py-3">{{ user.department ? user.department.value : '–' }}</td>
                                <td class="px-4 py-3">
                                    {% for role in user.rolesArray %}
                                        <span class="inline-block bg-indigo-200 text-indigo-800 text-xs font-semibold px-2 py-1 rounded mr-1">{{ role.value }}</span>
                                    {% endfor %}
                                </td>
                                <td class="px-4 py-3">{{ user.team ? user.team.name : '–' }}</td>
                                <td class="px-4 py-3">{{ user.leaveBalance }}</td>
                                <td class="px-4 py-3">{{ user.hireDate ? user.hireDate|date('Y-m-d') : '–' }}</td>
                                <td class="px-4 py-3">
                                  <button type="button" class="text-indigo-600 hover:underline text-sm mr-3 edit-user-btn"
                                          data-user-id="{{ user.id }}"
                                          data-toggle="modal"
                                          data-target="#editUserModal{{ user.id }}">
                                      Modifier
                                  </button>

                                    <button type="button" class="text-red-600 hover:underline text-sm delete-user-btn"
                                            data-user-id="{{ user.id }}"
                                            data-toggle="modal"
                                            data-target="#deleteUserModal{{ user.id }}">
                                        Supprimer
                                    </button>
                                </td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                {% else %}
                    <p class="text-center text-gray-500">Aucun utilisateur enregistré pour le moment.</p>
                {% endif %}
            </div>
        </div>
    </main>

    <!-- Create User Modal -->
    <div class="modal fade" id="createUserModal" tabindex="-1" role="dialog" aria-labelledby="createUserModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg" role="document">
            <div class="modal-content">
                {{ form_start(createForm, {
                    'method': 'POST',
                    'action': path('admin_index'),
                    'attr': {'class': 'needs-validation create-user-form', 'novalidate': true, 'id': 'createUserForm'}
                }) }}
                    <div class="modal-header">
                        <h5 class="modal-title" id="createUserModalLabel">Ajouter un nouvel utilisateur</h5>
                        <button type="button" class="close" data-dismiss="modal" aria-label="Fermer">
                            <span aria-hidden="true">&times;</span>
                        </button>
                    </div>

                    <div class="modal-body">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    {{ form_label(createForm.lastName, 'Nom', {'label_attr': {'class': 'font-weight-bold'}}) }}
                                    <span class="text-danger">*</span>
                                    {{ form_widget(createForm.lastName, {'attr': {'class': 'form-control'}}) }}
                                    {{ form_errors(createForm.lastName) }}
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    {{ form_label(createForm.firstName, 'Prénom', {'label_attr': {'class': 'font-weight-bold'}}) }}
                                    <span class="text-danger">*</span>
                                    {{ form_widget(createForm.firstName, {'attr': {'class': 'form-control'}}) }}
                                    {{ form_errors(createForm.firstName) }}
                                </div>
                            </div>
                        </div>

                        <div class="form-group">
                            {{ form_label(createForm.email, 'Email', {'label_attr': {'class': 'font-weight-bold'}}) }}
                            <span class="text-danger">*</span>
                            {{ form_widget(createForm.email, {'attr': {'class': 'form-control'}}) }}
                            {{ form_errors(createForm.email) }}
                        </div>

                        <div class="form-group">
                            {{ form_label(createForm.plainPassword, 'Mot de passe', {'label_attr': {'class': 'font-weight-bold'}}) }}
                            <span class="text-danger">*</span>
                            {{ form_widget(createForm.plainPassword, {'attr': {'class': 'form-control'}}) }}
                            {{ form_errors(createForm.plainPassword) }}
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    {{ form_label(createForm.department, 'Département', {'label_attr': {'class': 'font-weight-bold'}}) }}
                                    {{ form_widget(createForm.department, {'attr': {'class': 'form-control'}}) }}
                                    {{ form_errors(createForm.department) }}
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    {{ form_label(createForm.team, 'Équipe', {'label_attr': {'class': 'font-weight-bold'}}) }}
                                    {{ form_widget(createForm.team, {'attr': {'class': 'form-control'}}) }}
                                    {{ form_errors(createForm.team) }}
                                </div>
                            </div>
                        </div>

                        <div class="form-group">
                            {{ form_label(createForm.rolesArray, 'Rôle(s)', {'label_attr': {'class': 'font-weight-bold'}}) }}
                            <div class="row">
                                {% for choice in createForm.rolesArray %}
                                    <div class="col-md-6">
                                        <div class="form-check">
                                            {{ form_widget(choice, {'attr': {'class': 'form-check-input'}}) }}
                                            {{ form_label(choice, null, {'label_attr': {'class': 'form-check-label'}}) }}
                                        </div>
                                    </div>
                                {% endfor %}
                            </div>
                            {{ form_errors(createForm.rolesArray) }}
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    {{ form_label(createForm.leaveBalance, 'Solde de congé', {'label_attr': {'class': 'font-weight-bold'}}) }}
                                    {{ form_widget(createForm.leaveBalance, {'attr': {'class': 'form-control', 'step': '0.1'}}) }}
                                    {{ form_errors(createForm.leaveBalance) }}
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    {{ form_label(createForm.hireDate, 'Date d\'embauche', {'label_attr': {'class': 'font-weight-bold'}}) }}
                                    {{ form_widget(createForm.hireDate, {'attr': {'class': 'form-control'}}) }}
                                    {{ form_errors(createForm.hireDate) }}
                                </div>
                            </div>
                        </div>

                        {{ form_rest(createForm) }}
                    </div>

                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-dismiss="modal">Annuler</button>
                        <button type="submit" class="btn btn-success create-user-submit">
                            <i class="fas fa-plus mr-1"></i>
                            Créer l'utilisateur
                        </button>
                    </div>
                {{ form_end(createForm) }}
            </div>
        </div>
    </div>

    <!-- Edit User Modals -->
    {% for user in users %}
        <div class="modal fade" id="editUserModal{{ user.id }}" tabindex="-1" role="dialog" aria-labelledby="editUserModalLabel{{ user.id }}" aria-hidden="true">
            <div class="modal-dialog modal-lg" role="document">
                <div class="modal-content">
                    {{ form_start(editForms[user.id], {
                        'method': 'POST',
                        'action': path('admin_users_edit', {'id': user.id}),
                        'attr': {'class': 'needs-validation edit-user-form', 'novalidate': true, 'id': 'editUserForm' ~ user.id}
                    }) }}
                        <div class="modal-header">
                            <h5 class="modal-title" id="editUserModalLabel{{ user.id }}">Modifier l'utilisateur</h5>
                            <button type="button" class="close" data-dismiss="modal" aria-label="Fermer">
                                <span aria-hidden="true">&times;</span>
                            </button>
                        </div>

                        <div class="modal-body">
                            {{ form_widget(editForms[user.id]) }}
                        </div>

                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-dismiss="modal">Annuler</button>
                            <button type="submit" class="btn btn-primary edit-user-submit" data-user-id="{{ user.id }}">
                                <i class="fas fa-save mr-1"></i> Enregistrer les modifications
                            </button>
                        </div>
                    {{ form_end(editForms[user.id]) }}
                </div>
            </div>
        </div>

        <!-- Delete User Modal -->
        <div class="modal fade" id="deleteUserModal{{ user.id }}" tabindex="-1" role="dialog" aria-labelledby="deleteUserModalLabel{{ user.id }}" aria-hidden="true">
            <div class="modal-dialog" role="document">
                <form method="POST" action="{{ path('admin_users_delete', {'id': user.id}) }}" class="delete-user-form" data-user-id="{{ user.id }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete_user_' ~ user.id) }}">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title" id="deleteUserModalLabel{{ user.id }}">Confirmer la suppression</h5>
                            <button type="button" class="close" data-dismiss="modal" aria-label="Fermer">
                                <span aria-hidden="true">&times;</span>
                            </button>
                        </div>
                        <div class="modal-body">
                            Êtes-vous sûr de vouloir supprimer l'utilisateur <strong>{{ user.firstName }} {{ user.lastName }}</strong> ?
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-dismiss="modal">Annuler</button>
                            <button type="submit" class="btn btn-danger delete-user-submit" data-user-id="{{ user.id }}">Supprimer</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    {% endfor %}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        $(document).ready(function() {
            // Mobile menu toggle
            const menuBtn = document.getElementById('mobile-menu-btn');
            const sidebar = document.getElementById('sidebar');

            menuBtn?.addEventListener('click', () => {
                sidebar.classList.toggle('-translate-x-full');
            });

            // Form validation feedback
            function addFormValidationClasses() {
                document.querySelectorAll('.form-control').forEach(function(element) {
                    const errorDiv = element.parentNode.querySelector('.form-error, .invalid-feedback');
                    if (errorDiv && errorDiv.textContent.trim()) {
                        element.classList.add('is-invalid');
                    } else {
                        element.classList.remove('is-invalid');
                    }
                });
            }

            // Initial validation classes
            addFormValidationClasses();

            // Auto-show modal if there are form errors
            {% if createForm.vars.submitted and not createForm.vars.valid %}
                $('#createUserModal').modal('show');
            {% endif %}

            // Handle create user form submission
            $('.create-user-form').on('submit', function(e) {
                const submitBtn = $(this).find('.create-user-submit');
                submitBtn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin mr-1"></i> Création en cours...');

                // Re-enable button after a delay if form doesn't redirect
                setTimeout(function() {
                    submitBtn.prop('disabled', false).html('<i class="fas fa-plus mr-1"></i> Créer l\'utilisateur');
                }, 5000);
            });

            // Handle edit user form submission
            $('.edit-user-form').on('submit', function(e) {
                const userId = $(this).find('.edit-user-submit').data('user-id');
                const submitBtn = $(this).find('.edit-user-submit');
                submitBtn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin mr-1"></i> Modification en cours...');

                // Re-enable button after a delay if form doesn't redirect
                setTimeout(function() {
                    submitBtn.prop('disabled', false).html('<i class="fas fa-save mr-1"></i> Enregistrer les modifications');
                }, 5000);
            });

            // Handle delete user form submission
            $('.delete-user-form').on('submit', function(e) {
                const userId = $(this).data('user-id');
                const submitBtn = $(this).find('.delete-user-submit');
                submitBtn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin mr-1"></i> Suppression...');

                // Re-enable button after a delay if form doesn't redirect
                setTimeout(function() {
                    submitBtn.prop('disabled', false).html('Supprimer');
                }, 5000);
            });

            // Reset forms when modals are hidden
            $('.modal').on('hidden.bs.modal', function() {
                const form = $(this).find('form')[0];
                if (form && !$(form).hasClass('delete-user-form')) {
                    form.reset();
                    $(form).find('.form-control').removeClass('is-invalid');
                    $(form).find('.is-invalid').removeClass('is-invalid');
                }

                // Reset submit buttons
                $(this).find('[type="submit"]').prop('disabled', false);
                $(this).find('.create-user-submit').html('<i class="fas fa-plus mr-1"></i> Créer l\'utilisateur');
                $(this).find('.edit-user-submit').html('<i class="fas fa-save mr-1"></i> Enregistrer les modifications');
                $(this).find('.delete-user-submit').html('Supprimer');
            });

            // Prevent double submission
            $('form').on('submit', function() {
                $(this).find('[type="submit"]').prop('disabled', true);
            });

            // Handle modal backdrop clicks properly
            $('.modal').on('click', function(e) {
                if (e.target === this) {
                    $(this).modal('hide');
                }
            });

            // Auto-dismiss alerts after 5 seconds
            setTimeout(function() {
                $('.alert').alert('close');
            }, 5000);
        });
    </script>
{% endblock %}
