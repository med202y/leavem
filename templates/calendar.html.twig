{% extends 'base.html.twig' %}

{% block title %}Calendrier des Congés{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
    <link href="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.9/index.global.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.9/index.global.min.js"></script>

    <style>
        .calendar-card { transition: transform 0.2s; }
        .calendar-card:hover { transform: translateY(-3px); }
        .fc .fc-toolbar-title { font-size: 1.25rem; }
    </style>
{% endblock %}

{% block body %}
    <div class="container py-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1 class="d-flex align-items-center gap-2">
                <a href="{{ path('dashboard') }}" class="text-decoration-none text-dark" title="Retour">
                    <i class="bi bi-arrow-left" style="font-size: 1.5rem;"></i>
                </a>
                Calendrier des Congés
            </h1>
        </div>

        <div class="card shadow-sm calendar-card">
            <div class="card-header bg-primary text-white">
                <i class="bi bi-calendar-event"></i> Vue Globale des Congés (Tous les utilisateurs)
            </div>
            <div class="card-body">
                <div id="calendar"></div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.9/main.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var calendarEl = document.getElementById('calendar');

            var calendar = new FullCalendar.Calendar(calendarEl, {
                initialView: 'dayGridMonth',
                locale: 'fr',
                firstDay: 1,
                events: {{ events|raw }},
                eventDisplay: 'block',
                eventTextColor: 'white',
                height: 'auto'
            });

            calendar.render();
        });
    </script>
{% endblock %}
