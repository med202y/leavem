{% extends 'base.html.twig' %}

{% block title %}Gestion des utilisateurs{% endblock %}

{% block stylesheets %}
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js"></script>

{% endblock %}

{% block body %}
    <button id="mobile-menu-btn"
            class="md:hidden fixed top-4 left-4 z-50 bg-indigo-600 text-white p-3 rounded-lg shadow-md">
        <i class="fas fa-bars"></i>
    </button>

    <aside id="sidebar" class="fixed inset-y-0 left-0 z-50 w-72 bg-indigo-800 text-white shadow-md hidden md:block">
        <div class="h-full flex flex-col justify-between">
            <div>
                <div class="p-6 text-2xl font-bold">
                    <i class="fas fa-user-shield mr-2"></i> Administration
                </div>
                <nav class="flex-1 p-4">
                    <ul class="space-y-1">
                        {% set adminMenu = [
                            {'label': 'Utilisateurs', 'icon': '👤', 'url': path('admin_users_index')},
                            {'label': 'Équipes', 'icon': '👥', 'url': path('team')},
                            {'label': 'Tableau de bord', 'icon': '📊', 'url': path('dashboard')}
                        ] %}

                        {% for item in adminMenu %}
                            <li>
                                <a href="{{ item.url }}" class="flex items-center gap-2 px-4 py-2 rounded hover:bg-white/10 transition-colors">
                                    <span class="text-lg">{{ item.icon }}</span>
                                    <span class="text-sm font-medium">{{ item.label }}</span>
                                </a>
                            </li>
                        {% endfor %}
                    </ul>
                </nav>
            </div>
        </div>
    </aside>

    <main class="min-h-screen bg-gray-100 md:ml-72">
        <div class="p-6 max-w-7xl mx-auto">
            <div class="bg-white rounded-2xl p-6 shadow mb-6 flex justify-between items-center">
                <h1 class="text-3xl font-bold text-indigo-700">Gestion des utilisateurs</h1>
                <p class="text-sm text-gray-500">{{ "now"|date("l, F j, Y")|trans }}</p>
            </div>

            <div class="bg-white rounded-2xl shadow p-6 overflow-x-auto">
                {% if users|length > 0 %}
                    <table class="min-w-full table-auto">
                        <thead class="bg-indigo-100">
                        <tr>
                            <th class="px-4 py-2 text-left">Nom</th>
                            <th class="px-4 py-2 text-left">Prénom</th>
                            <th class="px-4 py-2 text-left">Email</th>
                            <th class="px-4 py-2 text-left">Département</th>
                            <th class="px-4 py-2 text-left">Rôle(s)</th>
                            <th class="px-4 py-2 text-left">Équipe</th>
                            <th class="px-4 py-2 text-left">Solde</th>
                            <th class="px-4 py-2 text-left">Date Embauche</th>
                            <th class="px-4 py-2 text-left">Actions</th>
                        </tr>
                        </thead>
                        <tbody>
                        {% for user in users %}
                            <tr class="border-b hover:bg-gray-50">
                                <td class="px-4 py-3">{{ user.nom }}</td>
                                <td class="px-4 py-3">{{ user.prenom }}</td>
                                <td class="px-4 py-3">{{ user.email }}</td>
                                <td class="px-4 py-3">{{ user.departement.value }}</td>
                                <td class="px-4 py-3">
                                    {% for role in user.role %}
                                        <span class="inline-block bg-indigo-200 text-indigo-800 text-xs font-semibold px-2 py-1 rounded mr-1">{{ role.name }}</span>
                                    {% endfor %}
                                </td>
                                <td class="px-4 py-3">{{ user.team.name}}</td>
                                <td class="px-4 py-3">{{ user.soldeConge }}</td>
                                <td class="px-4 py-3">{{ user.dateDembauche ? user.dateDembauche|date('Y-m-d') : '–' }}</td>
                                <td class="px-4 py-3">
                                    <!-- Trigger Button -->
                                    <button type="button" class="text-indigo-600 hover:underline text-sm" data-toggle="modal" data-target="#editUserModal{{ user.id }}">
                                        Modifier
                                    </button>

                                    <button type="button" class="text-red-600 hover:underline text-sm" data-toggle="modal" data-target="#deleteUserModal{{ user.id }}">
                                        Supprimer
                                    </button>

                                </td>
                            </tr>
                            <!-- Modal for Editing User -->
                            <div class="modal fade" id="editUserModal{{ user.id }}" tabindex="-1" role="dialog" aria-labelledby="editUserModalLabel{{ user.id }}" aria-hidden="true">
                                <div class="modal-dialog" role="document">
                                    <form method="POST" action="{{ path('admin_users_update', {'id': user.id}) }}">
                                        <div class="modal-content">
                                            <div class="modal-header">
                                                <h5 class="modal-title" id="editUserModalLabel{{ user.id }}">Modifier l'utilisateur</h5>
                                                <button type="button" class="close" data-dismiss="modal" aria-label="Fermer">
                                                    <span aria-hidden="true">&times;</span>
                                                </button>
                                            </div>

                                            <div class="modal-body">
                                                <div class="form-group">
                                                    <label>Nom</label>
                                                    <input name="nom" value="{{ user.nom }}" class="form-control" required>
                                                </div>
                                                <div class="form-group">
                                                    <label>Prénom</label>
                                                    <input name="prenom" value="{{ user.prenom }}" class="form-control" required>
                                                </div>
                                                <div class="form-group">
                                                    <label>Email</label>
                                                    <input name="email" type="email" value="{{ user.email }}" class="form-control" required>
                                                </div>
                                                <div class="form-group">
                                                    <label>Département</label>
                                                    <select name="departement" class="form-control">
                                                        {% for dept in departments %}
                                                            <option value="{{ dept.value }}" {% if dept == user.departement %}selected{% endif %}>{{ dept.name }}</option>
                                                        {% endfor %}
                                                    </select>
                                                </div>
                                                <div class="form-group">
                                                    <label>Rôle(s)</label>
                                                    {% for role in roles %}
                                                        <div class="form-check">
                                                            <input class="form-check-input" type="checkbox" name="roles[]" value="{{ role.value }}"
                                                                   {% if role in user.role %}checked{% endif %}>
                                                            <label class="form-check-label">{{ role.name }}</label>
                                                        </div>
                                                    {% endfor %}
                                                </div>
                                                <div class="form-group">
                                                    <label>Équipe</label>
                                                    <select name="team_id" class="form-control">
                                                        <option value="">— Aucun —</option>
                                                        {% for team in teams %}
                                                            <option value="{{ team.id }}" {% if user.team is not null and team.id == user.team.id %}selected{% endif %}>

                                                            {{ team.name }}
                                                            </option>
                                                        {% endfor %}
                                                    </select>
                                                </div>
                                                <div class="form-group">
                                                    <label>Solde de congé</label>
                                                    <input name="solde_conge" type="number" step="0.1" value="{{ user.soldeConge }}" class="form-control">
                                                </div>
                                                <div class="form-group">
                                                    <label>Date d'embauche</label>
                                                    <input name="date_embauche" type="date" value="{{ user.dateDembauche ? user.dateDembauche|date('Y-m-d') : '' }}" class="form-control">
                                                </div>
                                                <div class="form-group">
                                                    <label>Nouveau mot de passe (laisser vide pour ne pas changer)</label>
                                                    <input name="password" type="password" class="form-control">
                                                </div>
                                            </div>

                                            <div class="modal-footer">
                                                <button type="button" class="btn btn-secondary" data-dismiss="modal">Annuler</button>
                                                <button type="submit" class="btn btn-primary">Enregistrer</button>
                                            </div>
                                        </div>
                                    </form>
                                </div>
                            </div>
                            <!-- Modal for Deleting User -->
                            <div class="modal fade" id="deleteUserModal{{ user.id }}" tabindex="-1" role="dialog" aria-labelledby="deleteUserModalLabel{{ user.id }}" aria-hidden="true">
                                <div class="modal-dialog" role="document">
                                    <form method="POST" action="{{ path('admin_users_delete', {'id': user.id}) }}">
                                        <div class="modal-content">
                                            <div class="modal-header">
                                                <h5 class="modal-title" id="deleteUserModalLabel{{ user.id }}">Confirmer la suppression</h5>
                                                <button type="button" class="close" data-dismiss="modal" aria-label="Fermer">
                                                    <span aria-hidden="true">&times;</span>
                                                </button>
                                            </div>
                                            <div class="modal-body">
                                                Êtes-vous sûr de vouloir supprimer l'utilisateur <strong>{{ user.prenom }} {{ user.nom }}</strong> ?
                                            </div>
                                            <div class="modal-footer">
                                                <button type="button" class="btn btn-secondary" data-dismiss="modal">Annuler</button>
                                                <button type="submit" class="btn btn-danger">Supprimer</button>
                                            </div>
                                        </div>
                                    </form>
                                </div>
                            </div>


                        {% endfor %}
                        </tbody>
                    </table>
                {% else %}
                    <p class="text-center text-gray-500">Aucun utilisateur enregistré pour le moment.</p>
                {% endif %}
            </div>
        </div>
    </main>
{% endblock %}

{% block javascripts %}
    <script>
        const menuBtn = document.getElementById('mobile-menu-btn');
        const sidebar = document.getElementById('sidebar');
        menuBtn?.addEventListener('click', () => sidebar?.classList.toggle('-translate-x-full'));
    </script>
{% endblock %}
