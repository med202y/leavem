{# templates/conge/my_leaves.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}My Leave Requests{% endblock %}

{% block stylesheets %}
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
{% endblock %}

{% block body %}
    <div class="min-h-screen bg-gray-100 p-6">
        <div class="max-w-4xl mx-auto">
            <!-- header -->
            <div class="flex items-center justify-between mb-6">
                <h1 class="text-3xl font-bold text-indigo-700 flex items-center space-x-2">
                    <a href="{{ path('dashboard') }}" class="text-indigo-500 hover:text-indigo-700">
                        <i class="fas fa-arrow-left"></i>
                    </a>
                    <span>My Leave Requests</span>
                </h1>
                <a href="{{ path('demande') }}"
                   class="inline-flex items-center px-4 py-2 bg-indigo-600 text-white rounded-lg shadow hover:bg-indigo-700 transition">
                    <i class="fas fa-plus-circle mr-2"></i> New Leave Request
                </a>
            </div>

            <!-- status filters -->
            <div class="flex flex-wrap gap-2 mb-6">
                <button
                    class="status-filter px-3 py-1 rounded-full bg-white text-gray-800 border border-gray-300 hover:border-indigo-500 active:border-indigo-500"
                    data-status="all">All
                </button>
                {% for status in statuses %}
                    <button
                        class="status-filter px-3 py-1 rounded-full bg-{{ statusColors[status] }}-100 text-{{ statusColors[status] }}-800 hover:bg-{{ statusColors[status] }}-200"
                        data-status="{{ status }}">
                        {{ status }}
                    </button>
                {% endfor %}
            </div>

            {% if conges is empty %}
                <div class="bg-white p-4 rounded-lg shadow text-center text-gray-500">
                    <i class="fas fa-info-circle mr-2"></i>
                    You haven't submitted any leave requests yet.
                </div>
            {% else %}
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    {% for conge in conges %}
                        <div class="conge-card bg-white rounded-2xl shadow hover:shadow-lg transition p-4 flex flex-col justify-between"
                             data-status="{{ conge.statut.value }}">
                            <header class="flex justify-between items-center mb-3">
                                <span
                                    class="px-2 py-1 rounded-full bg-{{ statusColors[conge.statut.value] }}-100 text-{{ statusColors[conge.statut.value] }}-800 text-sm">
                                    {{ conge.statut.value }}
                                </span>
                                <span class="text-gray-400 text-sm">#{{ conge.id }}</span>
                            </header>

                            <div class="mb-4">
                                <h2 class="text-xl font-semibold text-gray-800 mb-2">
                                    <i class="fas fa-calendar-alt mr-1"></i>
                                    {{ conge.typeConge.value|title }}
                                </h2>

                                <div class="flex items-center justify-between text-gray-600 mb-2">
                                    <div>
                                        <small class="block">From</small>
                                        <span class="font-medium">{{ conge.dateDebut|date('M d, Y') }}</span>
                                    </div>
                                    <i class="fas fa-arrow-right mx-2"></i>
                                    <div>
                                        <small class="block">To</small>
                                        <span class="font-medium">{{ conge.dateFin|date('M d, Y') }}</span>
                                    </div>
                                </div>

                                <div class="mb-2">
                                    <small class="block text-gray-600">Duration</small>
                                    <span class="font-medium">{{ conge.dateFin.diff(conge.dateDebut).days + 1 }} days</span>
                                </div>

                                {% if conge.motif %}
                                    <div class="mb-2">
                                        <small class="block text-gray-600">Reason</small>
                                        <p>{{ conge.motif }}</p>
                                    </div>
                                {% endif %}

                                <div class="mb-2">
                                    <small class="block text-gray-600">Requested on</small>
                                    <span>{{ conge.dateDemande|date('M d, Y H:i') }}</span>
                                </div>
                                <div class="mb-2">
                                    <small class="block text-gray-600">Requested by</small>
                                    <span class="font-medium">
                                                 {{ conge.user.prenom }} {{ conge.user.nom }}
                                    </span>
                                </div>
                                {% if conge.dateTraitement %}
                                    <div>
                                        <small class="block text-gray-600">Processed on</small>
                                        <span>{{ conge.dateTraitement|date('M d, Y H:i') }}</span>
                                    </div>
                                {% endif %}
                            </div>

                            <footer class="flex items-center justify-between mt-4 pt-4 border-t border-gray-200">
                                <div>
                                    {% if conge.traitePar %}
                                        <small class="text-gray-500">Processed by: {{ conge.traitePar }}</small>
                                    {% endif %}
                                </div>
                                <div class="space-x-2">
                                    <button
                                        class="edit-btn px-3 py-1 text-sm rounded-lg border border-indigo-600 text-indigo-600 hover:bg-indigo-50 transition"
                                        data-id="{{ conge.id }}">
                                        Edit
                                    </button>
                                    <button
                                        class="cancel-btn px-3 py-1 text-sm rounded-lg bg-red-100 text-red-600 hover:bg-red-200 transition"
                                        data-id="{{ conge.id }}">
                                        Cancel
                                    </button>
                                </div>
                            </footer>
                        </div>
                    {% endfor %}
                </div>
            {% endif %}
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            // Status filtering
            document.querySelectorAll('.status-filter').forEach(btn => {
                btn.addEventListener('click', () => {
                    const status = btn.dataset.status;
                    document.querySelectorAll('.status-filter').forEach(b => b.classList.remove('border', 'font-bold'));
                    btn.classList.add('border', 'font-bold');

                    document.querySelectorAll('.conge-card').forEach(card => {
                        card.style.display = (status === 'all' || card.dataset.status === status) ? 'block' : 'none';
                    });
                });
            });

            // Edit
            document.querySelectorAll('.edit-btn').forEach(button => {
                button.addEventListener('click', () => {
                    const id = button.dataset.id;
                    const newStart = prompt("New start date (YYYY-MM-DD):");
                    const newEnd = prompt("New end date (YYYY-MM-DD):");
                    if (newStart && newEnd) {
                        fetch(`/edit-conge/${id}`, {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json',
                                'X-Requested-With': 'XMLHttpRequest'
                            },
                            body: JSON.stringify({ dateDebut: newStart, dateFin: newEnd })
                        })
                            .then(res => res.json())
                            .then(data => {
                                alert(data.success ? 'Updated!' : `Error: ${data.message}`);
                                if (data.success) location.reload();
                            });
                    }
                });
            });

            // Cancel
            document.querySelectorAll('.cancel-btn').forEach(button => {
                button.addEventListener('click', () => {
                    const id = button.dataset.id;
                    if (confirm("Cancel this leave?")) {
                        fetch(`/cancel-conge/${id}`, {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json',
                                'X-Requested-With': 'XMLHttpRequest'
                            }
                        })
                            .then(res => res.json())
                            .then(data => {
                                alert(data.success ? 'Cancelled!' : `Error: ${data.message}`);
                                if (data.success) location.reload();
                            });
                    }
                });
            });
        });
    </script>
{% endblock %}

