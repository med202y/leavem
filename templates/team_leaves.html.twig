{# templates/conge/my_leaves.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Mes Demandes de Congé{% endblock %}

{% block stylesheets %}
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
{% endblock %}

{% block body %}
    <div class="min-h-screen bg-gray-100 p-6">
        <div class="max-w-4xl mx-auto">
            <!-- En-tête -->
            <div class="flex items-center justify-between mb-6">
                <h1 class="text-3xl font-bold text-indigo-700 flex items-center space-x-2">
                    <a href="{{ path('dashboard') }}" class="text-indigo-500 hover:text-indigo-700">
                        <i class="fas fa-arrow-left"></i>
                    </a>
                    <span>Mes Demandes de Congé</span>
                </h1>
                <a href="{{ path('demande') }}"
                   class="inline-flex items-center px-4 py-2 bg-indigo-600 text-white rounded-lg shadow hover:bg-indigo-700 transition">
                    <i class="fas fa-plus-circle mr-2"></i> Nouvelle Demande
                </a>
            </div>

            <!-- Filtres par statut -->
            <div class="flex flex-wrap gap-2 mb-6">
                <button
                    class="status-filter px-3 py-1 rounded-full bg-white text-gray-800 border border-gray-300 hover:border-indigo-500 active:border-indigo-500"
                    data-status="all">Tous
                </button>
                {% for status in statuses %}
                    <button
                        class="status-filter px-3 py-1 rounded-full bg-{{ statusColors[status] }}-100 text-{{ statusColors[status] }}-800 hover:bg-{{ statusColors[status] }}-200"
                        data-status="{{ status }}">
                        {{ status|replace({'_': ' '})|title }}
                    </button>
                {% endfor %}
            </div>

            {% if conges is empty %}
                <div class="bg-white p-4 rounded-lg shadow text-center text-gray-500">
                    <i class="fas fa-info-circle mr-2"></i>
                    Vous n'avez soumis aucune demande de congé pour le moment.
                </div>
            {% else %}
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    {% for conge in conges %}
                        <div class="conge-card bg-white rounded-2xl shadow hover:shadow-lg transition p-4 flex flex-col justify-between"
                             data-status="{{ conge.statut.value }}">
                            <header class="flex justify-between items-center mb-3">
                                <span
                                    class="px-2 py-1 rounded-full bg-{{ statusColors[conge.statut.value] }}-100 text-{{ statusColors[conge.statut.value] }}-800 text-sm">
                                    {{ conge.statut.value|replace({'_': ' '})|title }}
                                </span>
                                <span class="text-gray-400 text-sm">#{{ conge.id }}</span>
                            </header>

                            <div class="mb-4">
                                <h2 class="text-xl font-semibold text-gray-800 mb-2">
                                    <i class="fas fa-calendar-alt mr-1"></i>
                                    {{ conge.typeConge.value|title }}
                                </h2>

                                <div class="flex items-center justify-between text-gray-600 mb-2">
                                    <div>
                                        <small class="block">Du</small>
                                        <span class="font-medium">{{ conge.dateDebut|date('d M Y') }}</span>
                                    </div>
                                    <i class="fas fa-arrow-right mx-2"></i>
                                    <div>
                                        <small class="block">Au</small>
                                        <span class="font-medium">{{ conge.dateFin|date('d M Y') }}</span>
                                    </div>
                                </div>

                                <div class="mb-2">
                                    <small class="block text-gray-600">Durée</small>
                                    <span class="font-medium">{{ conge.dateFin.diff(conge.dateDebut).days + 1 }} jours</span>
                                </div>

                                {% if conge.motif %}
                                    <div class="mb-2">
                                        <small class="block text-gray-600">Motif</small>
                                        <p>{{ conge.motif }}</p>
                                    </div>
                                {% endif %}

                                <div class="mb-2">
                                    <small class="block text-gray-600">Demandé le</small>
                                    <span>{{ conge.dateDemande|date('d M Y H:i') }}</span>
                                </div>
                                <div class="mb-2">
                                    <small class="block text-gray-600">Demandé par</small>
                                    <span class="font-medium">
                                        {{ conge.user.prenom }} {{ conge.user.nom }}
                                    </span>
                                </div>
                                {% if conge.dateTraitement %}
                                    <div>
                                        <small class="block text-gray-600">Traité le</small>
                                        <span>{{ conge.dateTraitement|date('d M Y H:i') }}</span>
                                    </div>
                                {% endif %}
                            </div>

                            <footer class="flex items-center justify-between mt-4 pt-4 border-t border-gray-200">
                                <div>
                                    {% if conge.traitePar %}
                                        <small class="text-gray-500">Traité par : {{ conge.traitePar }}</small>
                                    {% endif %}
                                </div>
                                <div class="space-x-2">
                                    <button
                                        class="action-btn accept-btn px-3 py-1 text-sm rounded-lg bg-green-100 text-green-600 hover:bg-green-200 transition"
                                        data-id="{{ conge.id }}"
                                        data-action="accept">
                                        Accepter
                                    </button>
                                    <button
                                        class="action-btn refuse-btn px-3 py-1 text-sm rounded-lg bg-red-100 text-red-600 hover:bg-red-200 transition"
                                        data-id="{{ conge.id }}"
                                        data-action="refuse">
                                        Refuser
                                    </button>
                                </div>
                            </footer>

                        </div>
                    {% endfor %}
                </div>
            {% endif %}
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            // Filtrage par statut
            document.querySelectorAll('.status-filter').forEach(btn => {
                btn.addEventListener('click', () => {
                    const status = btn.dataset.status;
                    document.querySelectorAll('.status-filter').forEach(b => b.classList.remove('border', 'font-bold'));
                    btn.classList.add('border', 'font-bold');

                    document.querySelectorAll('.conge-card').forEach(card => {
                        card.style.display = (status === 'all' || card.dataset.status === status) ? 'block' : 'none';
                    });
                });
            });

            // Gestion des boutons d'action
            document.querySelectorAll('.action-btn').forEach(button => {
                button.addEventListener('click', () => {
                    const id     = button.dataset.id;
                    const action  = button.dataset.action;  // "accept" ou "refuse"
                    const actionText = action === 'accept' ? 'accepter' : 'refuser';

                    if (!confirm(`Êtes-vous sûr de vouloir ${actionText} ce congé ?`)) {
                        return;
                    }

                    fetch(`/manager_leaves/update/${id}`, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/x-www-form-urlencoded',
                            'X-Requested-With': 'XMLHttpRequest'
                        },
                        body: new URLSearchParams({ action })
                    })
                        .then(res => {
                            if (!res.ok) throw new Error(res.statusText);
                            return res.json();
                        })
                        .then(data => {
                            if (data.success) {
                                alert(`Congé ${actionText} avec succès.`);
                                location.reload();
                            } else {
                                alert(`Erreur : ${data.message || 'Impossible de mettre à jour.'}`);
                            }
                        })
                        .catch(err => alert(`Erreur réseau : ${err.message}`));
                });
            });

        });
    </script>
{% endblock %}
