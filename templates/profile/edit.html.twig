{% extends 'base.html.twig' %}

{% block title %}Profil - {{ user.firstName }} {{ user.lastName }}{% endblock %}

{% block stylesheets %}
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <link href="{{ asset('css/sidebar-styles.css') }}" rel="stylesheet">
    <link href="{{ asset('css/profile-styles.css') }}" rel="stylesheet">
{% endblock %}

{% block body %}
    {% include 'partials/_sidebar.html.twig' %}

    <main class="profile-main-content">
        <div class="profile-container">
            <!-- Flash Messages -->
            {% for flash_error in app.flashes('error') %}
                <div class="flash-message-error">
                    {{ flash_error }}
                </div>
            {% endfor %}

            {% for flash_success in app.flashes('success') %}
                <div class="flash-message-success">
                    {{ flash_success }}
                </div>
            {% endfor %}

            <div class="profile-card">
                <h2 class="profile-title">Mon profil</h2>

                {{ form_start(form, {'attr': {'class': 'profile-form-container'}}) }}
                <div class="profile-grid">
                    <!-- Informations de contact -->
                    <div class="profile-section">
                        <h3 class="profile-section-title">Détails de contact</h3>
                        <div class="profile-section-content">
                            <div>
                                <label class="profile-field-label">Prénom</label>
                                <p class="profile-field-value">{{ user.firstName }}</p>
                            </div>
                            <div>
                                <label class="profile-field-label">Nom</label>
                                <p class="profile-field-value">{{ user.lastName }}</p>
                            </div>
                            <div>
                                <label class="profile-field-label">Département</label>
                                <p class="profile-field-value">{{ user.department.value }}</p>
                            </div>
                            <div>
                                <label class="profile-field-label">Email</label>
                                <p class="profile-field-value">{{ user.email }}</p>
                            </div>
                        </div>
                    </div>

                    <!-- Changement de mot de passe -->
                    <div class="profile-section">
                        <h3 class="profile-section-title">Changer le mot de passe</h3>
                        <div class="profile-section-content">
                            <div>
                                <label class="profile-field-label">Ancien mot de passe</label>
                                <input type="password" name="old_password" class="profile-password-input">
                            </div>
                            <div>
                                <label class="profile-field-label">Nouveau mot de passe</label>
                                <input type="password" name="new_password" class="profile-password-input">
                            </div>
                            <div>
                                <label class="profile-field-label">Confirmer mot de passe</label>
                                <input type="password" name="confirm_password" class="profile-password-input">
                            </div>
                            <div class="profile-password-requirements">
                                <p>• Le mot de passe doit contenir au moins 6 caractères</p>
                                <p>• Laissez vide si vous ne souhaitez pas changer le mot de passe</p>
                            </div>
                        </div>
                    </div>
                </div>

                {# Hidden form fields #}
                <div class="profile-hidden-fields">
                    {{ form_rest(form) }}
                </div>

                <div class="profile-actions">
                    <button type="button" class="profile-btn profile-btn-delete">Supprimer le profil</button>
                    <button type="submit" class="profile-btn profile-btn-submit">Mettre à jour</button>
                </div>
                {{ form_end(form) }}
            </div>
        </div>
    </main>
{% endblock %}
