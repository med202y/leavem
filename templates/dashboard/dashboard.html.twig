{% extends 'base.html.twig' %}

{% block title %}Dashboard - {{ user.prenom }} {{ user.nom }}{% endblock %}

{% block stylesheets %}
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
{% endblock %}

{% block body %}
    <!-- Mobile Menu Button -->
    <button id="mobile-menu-btn" class="md:hidden fixed top-4 left-4 z-50 bg-indigo-600 text-white p-3 rounded-lg shadow-md">
        <i class="fas fa-bars"></i>
    </button>

    <!-- Sidebar -->
    <aside id="sidebar" class="sidebar fixed top-0 left-0 h-full w-72 z-50 bg-gradient-to-br from-indigo-600 to-purple-700 text-white transform transition-transform duration-300 md:translate-x-0 -translate-x-full md:block">
        <div class="flex flex-col h-full">
            <!-- Logo -->
            <div class="p-6 border-b border-white/10">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 bg-white/20 rounded-xl flex items-center justify-center">
                        <i class="fas fa-building text-xl"></i>
                    </div>
                    <div>
                        <h1 class="text-xl font-bold">HR Portal</h1>
                        <p class="text-sm opacity-70">Management System</p>
                    </div>
                </div>
            </div>

            <!-- User Info -->
            <div class="p-6 border-b border-white/10">
                <div class="flex items-center gap-3">
                    <div class="w-12 h-12 bg-white/20 rounded-xl flex items-center justify-center font-bold text-lg">
                        {{ user.prenom|slice(0,1)|upper }}{{ user.nom|slice(0,1)|upper }}
                    </div>
                    <div>
                        <h3 class="font-semibold">{{ user.prenom }} {{ user.nom }}</h3>
                        <p class="text-sm opacity-70">{{ role.name ?? 'Employee' }}</p>
                        <p class="text-xs opacity-60">{{ departement.name ?? 'N/A' }}</p>
                    </div>
                </div>
            </div>

            <!-- Nav -->
            <nav class="flex-1 p-4 space-y-2">
                {% set current_route = app.request.attributes.get('_route') %}
                {% set navItems = [
                    {'label': 'Dashboard', 'icon': 'home', 'path': 'dashboard'},
                    {'label': 'Request Leave', 'icon': 'plus', 'url': '/leave/request'},
                    {'label': 'Leave History', 'icon': 'history', 'url': '/leave/history'},
                    {'label': 'Team', 'icon': 'users', 'url': '/team'}
                ] %}
                {% set menu = [
                    {'label': 'Dashboard', 'icon': '🏠', 'url': '#'},
                    {'label': 'Requests', 'icon': '📄', 'url': '#'},
                    {'label': 'Team', 'icon': '👥', 'url': '#'}
                ] %}

                {% for item in menu %}
                    <li>
                        <a href="{{ item.url }}" class="flex items-center gap-3 px-4 py-2 rounded hover:bg-white/10">
                            <span class="text-lg">{{ item.icon }}</span>
                            <span class="text-sm font-medium">{{ item.label }}</span>
                        </a>
                    </li>
                {% endfor %}
                {% if role.name in ['ADMIN', 'MANAGER'] %}
                    <div class="pt-4">
                        <p class="text-xs uppercase tracking-wide px-4 mb-2 opacity-60">Management</p>
                        <a href="#" class="flex items-center gap-3 px-4 py-3 rounded-lg hover:bg-white/5 text-white/80">
                            <i class="fas fa-users-cog w-5"></i>
                            <span>Manage Users</span>
                        </a>
                        <a href="#" class="flex items-center gap-3 px-4 py-3 rounded-lg hover:bg-white/5 text-white/80">
                            <i class="fas fa-calendar-check w-5"></i>
                            <span>Manage Leaves</span>
                        </a>
                    </div>
                {% endif %}

                <div class="pt-4">
                    <p class="text-xs uppercase tracking-wide px-4 mb-2 opacity-60">Account</p>
                    <a href="#" class="flex items-center gap-3 px-4 py-3 rounded-lg hover:bg-white/5 text-white/80">
                        <i class="fas fa-user-cog w-5"></i>
                        <span>Profile Settings</span>
                    </a>
                    <a href="#" class="flex items-center gap-3 px-4 py-3 rounded-lg hover:bg-white/5 text-white/80">
                        <i class="fas fa-sign-out-alt w-5"></i>
                        <span>Logout</span>
                    </a>
                </div>
            </nav>
        </div>
    </aside>

    <!-- Main Content -->
    <main class="min-h-screen bg-gray-100 md:ml-72 transition-all">
        <div class="p-6 max-w-7xl mx-auto">
            <!-- Welcome Card -->
            <div class="bg-white rounded-2xl p-6 shadow mb-6">
                <div class="flex justify-between items-center flex-wrap gap-4">
                    <div>
                        <h1 class="text-3xl font-bold text-indigo-700">Welcome back, {{ user.prenom }}!</h1>
                        <p class="text-gray-600">Here's what's happening with your leave management today.</p>
                    </div>
                    <div class="text-right hidden md:block">
                        <p class="text-sm text-gray-500">{{ "now"|date("l, F j, Y") }}</p>
                        <p class="text-lg font-semibold text-gray-800">{{ user.email }}</p>
                    </div>
                </div>
            </div>

            <!-- Stats Grid -->
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-6">
                {% set stats = [
                    {'label': 'Leave Balance', 'value': user.soldeConge ?? 0, 'icon': 'calendar-check', 'color': 'indigo', 'unit': 'Days Available'},
                    {'label': 'Pending Requests', 'value': 2, 'icon': 'clock', 'color': 'yellow', 'unit': 'Awaiting Approval'},
                    {'label': 'Approved Leaves', 'value': 5, 'icon': 'check-circle', 'color': 'green', 'unit': 'This Year'},
                    {'label': 'Team Members', 'value': 12, 'icon': 'users', 'color': 'blue', 'unit': 'In Department'}
                ] %}

                {% for stat in stats %}
                    <div class="bg-white rounded-2xl p-5 shadow hover:shadow-lg transition-all">
                        <div class="flex justify-between items-center">
                            <div>
                                <p class="text-sm text-gray-600">{{ stat.label }}</p>
                                <p class="text-3xl font-bold text-{{ stat.color }}-600">{{ stat.value }}</p>
                                <p class="text-xs text-gray-400">{{ stat.unit }}</p>
                            </div>
                            <div class="w-12 h-12 rounded-xl flex items-center justify-center bg-{{ stat.color }}-500">
                                <i class="fas fa-{{ stat.icon }} text-white text-xl"></i>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>

            <!-- Quick Actions -->
            <div class="bg-white rounded-2xl p-6 shadow mb-6">
                <h2 class="text-xl font-semibold text-gray-800 mb-4 flex items-center gap-2">
                    <i class="fas fa-bolt"></i> Quick Actions
                </h2>
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
                    {% set actions = [
                        {'label': 'Request Leave', 'icon': 'plus', 'url': '#'},
                        {'label': 'View History', 'icon': 'history', 'url': '#'},
                        {'label': 'Update Profile', 'icon': 'user-cog', 'url': '#'},
                        {'label': 'View Team', 'icon': 'users', 'url': '#'}
                    ] %}

                    {% for action in actions %}
                        <a href="{{ action.url }}" class="bg-gradient-to-br from-indigo-500 to-purple-600 text-white px-4 py-4 rounded-xl font-medium flex items-center gap-3 hover:shadow-lg hover:translate-y-[-2px] transition-all">
                            <i class="fas fa-{{ action.icon }}"></i> <span>{{ action.label }}</span>
                        </a>
                    {% endfor %}
                </div>
            </div>

            <!-- Recent Activity -->
            <div class="bg-white rounded-2xl p-6 shadow">
                <h2 class="text-xl font-semibold text-gray-800 mb-4 flex items-center gap-2">
                    <i class="fas fa-bell"></i> Recent Activity
                </h2>
                <div class="space-y-4">
                    {% set activities = [
                        {'type': 'success', 'icon': 'check', 'title': 'Leave Request Approved', 'desc': 'Your vacation request for March 15-20 has been approved', 'time': '2 hours ago'},
                        {'type': 'info', 'icon': 'paper-plane', 'title': 'New Leave Request Submitted', 'desc': 'Sick leave request for tomorrow has been submitted', 'time': '1 day ago'},
                        {'type': 'purple', 'icon': 'user-plus', 'title': 'Profile Updated', 'desc': 'Your profile information has been successfully updated', 'time': '3 days ago'},
                        {'type': 'warning', 'icon': 'calendar', 'title': 'Leave Balance Refreshed', 'desc': 'Your annual leave balance has been updated for the new year', 'time': '1 week ago'}
                    ] %}

                    {% for act in activities %}
                        <div class="flex items-start gap-4 p-4 rounded-xl border-l-4 bg-{{ act.type == 'success' ? 'green' : act.type == 'info' ? 'blue' : act.type == 'purple' ? 'purple' : 'yellow' }}-50 border-{{ act.type == 'success' ? 'green' : act.type == 'info' ? 'blue' : act.type == 'purple' ? 'purple' : 'yellow' }}-500">
                            <div class="w-10 h-10 bg-{{ act.type == 'success' ? 'green' : act.type == 'info' ? 'blue' : act.type == 'purple' ? 'purple' : 'yellow' }}-500 rounded-full flex items-center justify-center">
                                <i class="fas fa-{{ act.icon }} text-white"></i>
                            </div>
                            <div class="flex-1">
                                <p class="font-semibold text-gray-800">{{ act.title }}</p>
                                <p class="text-sm text-gray-600">{{ act.desc }}</p>
                                <p class="text-xs text-gray-500">{{ act.time }}</p>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            </div>
        </div>
    </main>

{% endblock %}

{% block javascripts %}
    <script>
        const menuBtn = document.getElementById('mobile-menu-btn');
        const sidebar = document.getElementById('sidebar');
        menuBtn?.addEventListener('click', () => sidebar?.classList.toggle('-translate-x-full'));
    </script>
{% endblock %}
