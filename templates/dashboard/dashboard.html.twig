<!-- Formulaire -->
<form method="post" class="space-y-6">
    <!-- Informations du salarié -->
    <div class="bg-white rounded-2xl shadow p-6 mb-6">
        <h2 class="text-xl font-semibold text-gray-800 mb-4 border-b pb-2 flex items-center gap-2">
            <i class="fas fa-user"></i> Informations du Salarié
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            {% set fields = {
                'nom': user.nom,
                'prenom': user.prenom,
                'cin': user.cin,
                'cnss': user.cnss,
                'salaire': user.salaireM,
                'qualifications': user.qualificationsprofessionnelles,
                'jours_travailles': user.nbrDeJoursTravaille,
                'jours_droit_conge': user.jourdecongeTravail,
                'date_ouverture_droit': user.dateDouvertureDroitAuConge,
                'solde_conge': user.soldeConge,
                'observations': user.observations
            } %}

            <!-- Column 1 -->
            <div class="space-y-4">
                {% for key, val in {'nom': 'Nom', 'prenom': 'Prénom', 'cin': 'CIN', 'cnss': 'Numéro CNSS'} %}
                    <div>
                        <label class="form-label" for="{{ key }}">{{ val }}</label>
                        <input type="text" name="{{ key }}" id="{{ key }}" class="form-input bg-gray-100" value="{{ fields[key] }}" readonly>
                    </div>
                {% endfor %}
            </div>

            <!-- Column 2 -->
            <div class="space-y-4">
                <div>
                    <label class="form-label" for="date_embauche">Date d'embauche</label>
                    <input type="date" name="date_embauche" id="date_embauche" class="form-input" required>
                </div>
                <div>
                    <label class="form-label" for="salaire">Salaire mensuel</label>
                    <input type="number" name="salaire" id="salaire" class="form-input bg-gray-100" value="{{ user.salaireM }}" readonly>
                </div>
                <div>
                    <label class="form-label" for="poste">Poste / Fonction</label>
                    <input type="text" name="poste" id="poste" class="form-input" required>
                </div>
                <div>
                    <label class="form-label" for="qualifications">Qualifications professionnelles</label>
                    <input type="text" name="qualifications" id="qualifications" class="form-input bg-gray-100" value="{{ user.qualificationsprofessionnelles }}" readonly>
                </div>
            </div>
        </div>
    </div>

    <!-- Gestion des congés -->
    <div class="bg-white rounded-2xl shadow p-6">
        <h2 class="text-xl font-semibold text-gray-800 mb-4 border-b pb-2 flex items-center gap-2">
            <i class="fas fa-calendar-alt"></i> Gestion des Congés
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <!-- Column 1 -->
            <div class="space-y-4">
                {% for key, label in {
                    'jours_travailles': 'Jours effectivement travaillés',
                    'jours_droit_conge': 'Jours ouvrant droit à congé'
                } %}
                    <div>
                        <label class="form-label" for="{{ key }}">{{ label }}</label>
                        <input type="number" name="{{ key }}" id="{{ key }}" class="form-input bg-gray-100" value="{{ fields[key] }}" readonly>
                    </div>
                {% endfor %}
                <div>
                    <label class="form-label" for="date_ouverture_droit">Date d'ouverture du droit</label>
                    <input type="date" name="date_ouverture_droit" id="date_ouverture_droit" class="form-input bg-gray-100" value="{{ user.dateDouvertureDroitAuConge|date('Y-m-d') }}" readonly>
                </div>
            </div>

            <!-- Column 2 -->
            <div class="space-y-4">
                <div>
                    <label class="form-label" for="solde_conge">Solde de congés</label>
                    <input type="number" step="0.5" name="solde_conge" id="solde_conge" class="form-input bg-gray-100" value="{{ user.soldeConge }}" readonly>
                </div>
                <div>
                    <label class="form-label" for="date_debut_conge">Date de début du congé</label>
                    <input type="date" name="date_debut_conge" id="date_debut_conge" class="form-input">
                </div>
                <div>
                    <label class="form-label" for="date_fin_conge">Date de fin du congé</label>
                    <input type="date" name="date_fin_conge" id="date_fin_conge" class="form-input">
                </div>
            </div>
        </div>

        <!-- Additional Info -->
        <div class="mt-6 grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
                <label class="form-label" for="duree_conge">Durée du congé (jours)</label>
                <input type="number" name="duree_conge" id="duree_conge" class="form-input">
            </div>
            <div>
                <label class="form-label" for="date_retour">Date de retour</label>
                <input type="date" name="date_retour" id="date_retour" class="form-input">
            </div>
        </div>

        <div class="mt-6">
            <label class="form-label" for="observations">Observations</label>
            <textarea name="observations" id="observations" rows="3" class="form-input bg-gray-100" readonly>{{ user.observations }}</textarea>
        </div>
    </div>

    <!-- Buttons -->
    <div class="flex justify-end gap-4 mt-6">
        <button type="reset" class="px-4 py-2 rounded-xl bg-gray-100 hover:bg-gray-200 text-sm font-medium shadow">
            Annuler
        </button>
        <button type="submit" class="px-4 py-2 rounded-xl bg-gradient-to-r from-indigo-600 to-purple-600 text-white text-sm font-semibold hover:shadow-lg transition-all">
            Enregistrer
        </button>
    </div>
</form>
