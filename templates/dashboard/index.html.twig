{% extends 'base.html.twig' %}

{% block title %}Tableau de bord - {{ user.firstName }} {{ user.lastName }}{% endblock %}

{% block stylesheets %}
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
{% endblock %}

{% block body %}
    <!-- Bouton menu mobile -->
    <button id="mobile-menu-btn" class="md:hidden fixed top-4 left-4 z-50 bg-indigo-600 text-white p-3 rounded-lg shadow-md">
        <i class="fas fa-bars"></i>
    </button>

    <!-- Barre latérale -->
    <aside id="sidebar" class="sidebar fixed top-0 left-0 h-full w-72 z-50 bg-gradient-to-br from-indigo-600 to-purple-700 text-white transform transition-transform duration-300 md:translate-x-0 -translate-x-full md:block">
        <div class="flex flex-col h-full">
            <!-- Logo -->
            <div class="p-6 border-b border-white/10">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 bg-white/20 rounded-xl flex items-center justify-center">
                        <i class="fas fa-building text-xl"></i>
                    </div>
                    <div>
                        <h1 class="text-xl font-bold">Portail RH</h1>
                        <p class="text-sm opacity-70">Système de gestion</p>
                    </div>
                </div>
            </div>

            <!-- Infos utilisateur -->
            <div class="p-6 border-b border-white/10">
                <div class="flex items-center gap-3">
                    <div class="w-12 h-12 bg-white/20 rounded-xl flex items-center justify-center font-bold text-lg">
                        {{ user.firstName|slice(0,1)|upper }}{{ user.lastName|slice(0,1)|upper }}
                    </div>
                    <div>
                        <h3 class="font-semibold">{{ user.firstName }} {{ user.lastName }}</h3>
                        <p class="text-sm opacity-70">{{ role ?? 'Employé' }}</p>
                        <p class="text-xs opacity-60">{{ user.department.value ?? 'N/A' }}</p>
                    </div>
                </div>
            </div>

            <!-- Navigation -->
            <nav class="flex-1 p-4">
                <ul class="space-y-1">
                    {% set current_route = app.request.attributes.get('_route') %}
                    {% set navItems = [
                        {'label': 'Tableau de bord', 'icon': 'home', 'path': 'dashboard'},
                        {'label': 'Demander un congé', 'icon': 'plus', 'path': 'demande'},
                        {'label': 'Historique des congés', 'icon': 'history', 'path': 'my_leaves'},
                        {'label': 'Équipe', 'icon': 'users', 'path': 'team'}
                    ] %}
                    {% set menu = [
                        {'label': 'Tableau de bord', 'icon': '🏠', 'path': 'dashboard'},
                        {'label': 'Demandes', 'icon': '📄', 'path': 'my_leaves'},
                        {'label': 'Équipe', 'icon': '👥', 'path': 'team'}
                    ] %}

                    {% for item in menu %}
                        <li>
                            <a href="{{ path(item.path) }}" class="flex items-center gap-2 px-4 py-2 rounded hover:bg-white/10 transition-colors">
                                <span class="text-lg">{{ item.icon }}</span>
                                <span class="text-sm font-medium">{{ item.label }}</span>
                            </a>
                        </li>
                    {% endfor %}
                </ul>
                {% if 'ROLE_MANAGER' in user.roles or 'ROLE_ADMIN' in user.roles %}
                    <div class="pt-4">
                        <p class="text-xs uppercase tracking-wide px-4 mb-2 opacity-60">Gestion</p>
                        <a href="{{ path('manager_leaves') }}" class="flex items-center gap-2 px-4 py-3 rounded-lg hover:bg-white/5 text-white/80">
                            <i class="fas fa-calendar-check w-5"></i>
                            <span>Gérer les congés</span>
                        </a>
                        {% if 'ROLE_ADMIN' in user.roles %}
                        <a href="{{ path('admin_index') }}" class="flex items-center gap-2 px-4 py-3 rounded-lg hover:bg-white/5 text-white/80">
                            <i class="fas fa-users-cog w-5"></i>
                            <span>Gérer les utilisateurs</span>
                        </a>
                            <a href="{{ path('app_calendar') }}" class="flex items-center gap-2 px-4 py-3 rounded-lg hover:bg-white/5 text-white/80">
                                <i class="fas fa-calendar-alt w-5"></i>
                                <span>Voir Calendrier</span>
                            </a>
                        {% endif %}
                    </div>
                {% endif %}

                <div class="pt-4">
                    <p class="text-xs uppercase tracking-wide px-4 mb-2 opacity-60">Compte</p>
                    <a href="{{ path('user_profile') }}" class="flex items-center gap-3 px-4 py-3 rounded-lg hover:bg-white/5 text-white/80">
                        <i class="fas fa-user-cog w-5"></i>
                        <span>Paramètres du profil</span>
                    </a>
                    <a href="{{ path('app_logout') }}" class="flex items-center gap-3 px-4 py-3 rounded-lg hover:bg-white/5 text-white/80">
                        <i class="fas fa-sign-out-alt w-5"></i>
                        <span>Déconnexion</span>
                    </a>
                </div>
            </nav>
        </div>
    </aside>

    <!-- Contenu principal -->
    <main class="min-h-screen bg-gray-100 md:ml-72 transition-all">
        <div class="p-6 max-w-7xl mx-auto">
            <!-- Carte de bienvenue -->
            <div class="bg-white rounded-2xl p-6 shadow mb-6">
                <div class="flex justify-between items-center flex-wrap gap-4">
                    <div>
                        <h1 class="text-3xl font-bold text-indigo-700">Bon retour, {{ user.firstName }} !</h1>
                        <p class="text-gray-600">Voici ce qui se passe aujourd'hui dans la gestion de vos congés.</p>
                    </div>
                    <div class="text-right hidden md:block">
                        <p class="text-sm text-gray-500">{{ "now"|date("l, F j, Y")|trans }}</p>
                        <p class="text-lg font-semibold text-gray-800">{{ user.email }}</p>
                    </div>
                </div>
            </div>

            <!-- Statistiques -->
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-6">
                {% for stat in dashboardStats %}
                    <div class="bg-white rounded-2xl p-5 shadow hover:shadow-lg transition-all">
                        <div class="flex justify-between items-center">
                            <div>
                                <p class="text-sm text-gray-600">{{ stat.label }}</p>
                                <p class="text-3xl font-bold text-{{ stat.color }}-600">{{ stat.value }}</p>
                                <p class="text-xs text-gray-400">{{ stat.unit }}</p>
                            </div>
                            <div class="w-12 h-12 rounded-xl flex items-center justify-center bg-{{ stat.color }}-500">
                                <i class="fas fa-{{ stat.icon }} text-white text-xl"></i>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>

            <!-- Actions rapides -->
            <div class="bg-white rounded-2xl p-6 shadow mb-6">
                <h2 class="text-xl font-semibold text-gray-800 mb-4 flex items-center gap-2">
                    <i class="fas fa-bolt"></i> Actions rapides
                </h2>
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
                    {% set actions = [
                        {'label': 'Demander un congé', 'icon': 'plus', 'url': path('request_leave')},
                        {'label': 'Voir l\'historique', 'icon': 'history', 'url': path('notifications_history')},
                        {'label': 'Mettre à jour le profil', 'icon': 'user-cog', 'url': path('user_profile')},
                        {'label': 'Voir l\'équipe', 'icon': 'users', 'url': path('team')}
                    ] %}

                    {% for action in actions %}
                        <a href="{{ action.url }}" class="bg-gradient-to-br from-indigo-500 to-purple-600 text-white px-4 py-4 rounded-xl font-medium flex items-center gap-3 hover:shadow-lg hover:translate-y-[-2px] transition-all">
                            <i class="fas fa-{{ action.icon }}"></i> <span>{{ action.label }}</span>
                        </a>
                    {% endfor %}
                </div>
            </div>

            <!-- Activité récente -->
            <div class="bg-white rounded-2xl p-6 shadow">
                <h2 class="text-xl font-semibold text-gray-800 mb-4 flex items-center gap-2">
                    <i class="fas fa-bell"></i> Activité récente
                </h2>
                <div class="space-y-4">
                    {% for notification in notifications %}
                        <div class="flex items-start gap-4 p-4 rounded-xl border-l-4 bg-blue-50 border-blue-500">
                            <div class="w-10 h-10 bg-blue-500 rounded-full flex items-center justify-center">
                                <i class="fas fa-paper-plane text-white"></i>
                            </div>
                            <div class="flex-1">
                                <p class="font-semibold text-gray-800">{{ notification.title }}</p>
                                <p class="text-sm text-gray-600">{{ notification.message }}</p>
                                {% if notification.createdAt %}
                                    <p class="text-xs text-gray-500 mt-1">{{ notification.createdAt|date('d/m/Y H:i') }}</p>
                                {% endif %}
                            </div>
                        </div>
                    {% else %}
                        <p class="text-gray-500">Aucune activité récente.</p>
                    {% endfor %}
                </div>
            </div>
        </div>
    </main>
{% endblock %}

{% block javascripts %}
    <script>
        const menuBtn = document.getElementById('mobile-menu-btn');
        const sidebar = document.getElementById('sidebar');
        menuBtn?.addEventListener('click', () => sidebar?.classList.toggle('-translate-x-full'));
    </script>
{% endblock %}
