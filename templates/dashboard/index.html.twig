{% extends 'base.html.twig' %}

{% block title %}Tableau de bord - {{ user.firstName }} {{ user.lastName }}{% endblock %}

{% block stylesheets %}

    <link href="{{ asset('css/sidebar-styles.css') }}" rel="stylesheet">
    <link href="{{ asset('css/dashboard-styles.css') }}" rel="stylesheet">
{% endblock %}

{% block body %}
    {% include 'partials/_sidebar.html.twig' %}


    <!-- Contenu principal -->
    <main class="dashboard-main">
        <div class="dashboard-container">
            <!-- Carte de bienvenue -->
            <div class="welcome-card">
                <div class="welcome-card-header">
                    <div>
                        <h1 class="welcome-title">Bon retour, {{ user.firstName }} !</h1>
                        <p class="welcome-subtitle">Voici ce qui se passe aujourd'hui dans la gestion de vos congés.</p>
                    </div>
                    <div class="welcome-info">
                        <p class="welcome-date">{{ "now"|date("l, F j, Y")|trans }}</p>
                        <p class="welcome-email">{{ user.email }}</p>
                    </div>
                </div>
            </div>

            <!-- Statistiques -->
            <div class="stats-grid">
                {% for stat in dashboardStats %}
                    <div class="stat-card">
                        <div class="stat-card-content">
                            <div>
                                <p class="stat-label">{{ stat.label }}</p>
                                <p class="stat-value text-{{ stat.color }}-600">{{ stat.value }}</p>
                                <p class="stat-unit">{{ stat.unit }}</p>
                            </div>
                            <div class="stat-icon-wrapper bg-{{ stat.color }}-500">
                                <i class="fas fa-{{ stat.icon }} stat-icon"></i>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>

            <!-- Actions rapides -->
            <div class="actions-card">
                <h2 class="actions-title">
                    <i class="fas fa-bolt"></i> Actions rapides
                </h2>
                <div class="actions-grid">
                    {% set actions = [
                        {'label': 'Demander un congé', 'icon': 'plus', 'url': path('request_leave')},
                        {'label': 'Voir l\'historique', 'icon': 'history', 'url': path('notifications_history')},
                        {'label': 'Mettre à jour le profil', 'icon': 'user-cog', 'url': path('user_profile')},
                        {'label': 'Voir l\'équipe', 'icon': 'users', 'url': path('team')}
                    ] %}

                    {% for action in actions %}
                        <a href="{{ action.url }}" class="action-button">
                            <i class="fas fa-{{ action.icon }}"></i> <span>{{ action.label }}</span>
                        </a>
                    {% endfor %}
                </div>
            </div>

            <!-- Activité récente -->
            <div class="activity-card">
                <h2 class="activity-title">
                    <i class="fas fa-bell"></i> Activité récente
                </h2>
                <div class="activity-list">
                    {% for notification in notifications %}
                        <div class="activity-item">
                            <div class="activity-icon-wrapper">
                                <i class="fas fa-paper-plane activity-icon"></i>
                            </div>
                            <div class="activity-content">
                                <p class="activity-content-title">{{ notification.title }}</p>
                                <p class="activity-content-message">{{ notification.message }}</p>
                                {% if notification.createdAt %}
                                    <p class="activity-content-date">{{ notification.createdAt|date('d/m/Y H:i') }}</p>
                                {% endif %}
                            </div>
                        </div>
                    {% else %}
                        <p class="activity-empty">Aucune activité récente.</p>
                    {% endfor %}
                </div>
            </div>
        </div>
    </main>
{% endblock %}

{% block javascripts %}
    <script>
        const menuBtn = document.getElementById('mobile-menu-btn');
        const sidebar = document.getElementById('sidebar');
        menuBtn?.addEventListener('click', () => sidebar?.classList.toggle('-translate-x-full'));
    </script>
{% endblock %}
