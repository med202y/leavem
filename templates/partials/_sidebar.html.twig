<!-- Bouton menu mobile -->
<button id="mobile-menu-btn"
        class="md:hidden fixed top-4 left-4 z-50 bg-indigo-600 text-white p-3 rounded-lg shadow-md">
    <i class="fas fa-bars"></i>
</button>

<!-- Barre latérale -->
<aside id="sidebar"
       class="sidebar fixed top-0 left-0 h-full w-72 z-50 bg-gradient-to-br from-indigo-600 to-purple-700
              text-white transform transition-transform duration-300 md:translate-x-0 -translate-x-full md:block">

    <div class="flex flex-col h-full">

        {# Logo #}
        <div class="p-6 border-b border-white/10">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 bg-white/20 rounded-xl flex items-center justify-center">
                    <i class="fas fa-building text-xl"></i>
                </div>
                <div>
                    <h1 class="text-xl font-bold">Portail RH</h1>
                    <p class="text-sm opacity-70">Système de gestion</p>
                </div>
            </div>
        </div>

        {# Infos utilisateur #}
        <div class="p-6 border-b border-white/10">
            <div class="flex items-center gap-3">
                <div class="w-12 h-12 bg-white/20 rounded-xl flex items-center justify-center font-bold text-lg">
                    {{ app.user.firstName|slice(0,1)|upper }}{{ app.user.lastName|slice(0,1)|upper }}
                </div>
                <div>
                    <h3 class="font-semibold">{{ app.user.firstName }} {{ app.user.lastName }}</h3>
                    <p class="text-sm opacity-70">{{ role ?? 'Employé' }}</p>
                    <p class="text-xs opacity-60">{{ app.user.department.value ?? 'N/A' }}</p>
                </div>
            </div>
        </div>

        {# Navigation principale #}
        <nav class="flex-1 p-4 overflow-y-auto">
            {% set menu = [
                {'label': 'Tableau de bord', 'icon': '🏠', 'path': 'dashboard'},
                {'label': 'Demandes', 'icon': '📄', 'path': 'my_leaves'},
                {'label': 'Équipe', 'icon': '👥', 'path': 'team'}
            ] %}

            <ul class="space-y-1">
                {% for item in menu %}
                    <li>
                        <a href="{{ path(item.path) }}"
                           class="flex items-center gap-2 px-4 py-2 rounded hover:bg-white/10 transition-colors">
                            <span class="text-lg">{{ item.icon }}</span>
                            <span class="text-sm font-medium">{{ item.label }}</span>
                        </a>
                    </li>
                {% endfor %}
            </ul>

            {# Section gestion #}
            {% if 'ROLE_MANAGER' in app.user.roles or 'ROLE_ADMIN' in app.user.roles %}
                <div class="pt-4">
                    <p class="text-xs uppercase tracking-wide px-4 mb-2 opacity-60">Gestion</p>

                    <a href="{{ path('manager_leaves') }}"
                       class="flex items-center gap-2 px-4 py-3 rounded-lg hover:bg-white/5 text-white/80">
                        <i class="fas fa-calendar-check w-5"></i>
                        <span>Gérer les congés</span>
                    </a>

                    {% if 'ROLE_ADMIN' in app.user.roles %}
                        <a href="{{ path('admin_index') }}"
                           class="flex items-center gap-2 px-4 py-3 rounded-lg hover:bg-white/5 text-white/80">
                            <i class="fas fa-users-cog w-5"></i>
                            <span>Gérer les utilisateurs</span>
                        </a>

                        <a href="{{ path('app_calendar') }}"
                           class="flex items-center gap-2 px-4 py-3 rounded-lg hover:bg-white/5 text-white/80">
                            <i class="fas fa-calendar-alt w-5"></i>
                            <span>Voir Calendrier</span>
                        </a>
                    {% endif %}
                </div>
            {% endif %}

            {# Compte #}
            <div class="pt-4">
                <p class="text-xs uppercase tracking-wide px-4 mb-2 opacity-60">Compte</p>

                <a href="{{ path('user_profile') }}"
                   class="flex items-center gap-3 px-4 py-3 rounded-lg hover:bg-white/5 text-white/80">
                    <i class="fas fa-user-cog w-5"></i>
                    <span>Paramètres du profil</span>
                </a>

                <form method="post" action="{{ path('app_logout') }}">
                    <input type="hidden" name="_csrf_token"
                           value="{{ csrf_token('logout') }}">

                    <button type="submit"
                            class="w-full flex items-center gap-3 px-4 py-3 rounded-lg
                   hover:bg-red-500/20 text-red-200 font-semibold">
                        <i class="fas fa-sign-out-alt w-5"></i>
                        <span>Déconnexion</span>
                    </button>
                </form>

            </div>
        </nav>
    </div>
</aside>
