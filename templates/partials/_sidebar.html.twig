<!-- Bouton menu mobile -->
<button id="mobile-menu-btn" class="mobile-menu-btn">
    <i class="fas fa-bars"></i>
</button>

<!-- Barre latérale -->
<aside id="sidebar" class="sidebar">

    <div class="sidebar-container">

        {# Logo #}
        <div class="sidebar-logo">
            <div class="sidebar-logo-content">
                <div class="sidebar-logo-icon">
                    <i class="fas fa-building"></i>
                </div>
                <div>
                    <h1 class="sidebar-logo-title">Portail RH</h1>
                    <p class="sidebar-logo-subtitle">Système de gestion</p>
                </div>
            </div>
        </div>

        {# Infos utilisateur #}
        <div class="sidebar-user">
            <div class="sidebar-user-content">
                <div class="sidebar-user-avatar">
                    {{ app.user.firstName|slice(0,1)|upper }}{{ app.user.lastName|slice(0,1)|upper }}
                </div>
                <div>
                    <h3 class="sidebar-user-name">{{ app.user.firstName }} {{ app.user.lastName }}</h3>
                    <p class="sidebar-user-role">{{ role ?? 'Employé' }}</p>
                    <p class="sidebar-user-department">{{ app.user.department.value ?? 'N/A' }}</p>
                </div>
            </div>
        </div>

        {# Navigation principale #}
        <nav class="sidebar-nav">
            {% set menu = [
                {'label': 'Tableau de bord', 'icon': '🏠', 'path': 'dashboard'},
                {'label': 'Demandes', 'icon': '📄', 'path': 'my_leaves'},
                {'label': 'Équipe', 'icon': '👥', 'path': 'team'}
            ] %}

            <ul class="sidebar-menu">
                {% for item in menu %}
                    <li>
                        <a href="{{ path(item.path) }}" class="sidebar-menu-link">
                            <span class="sidebar-menu-icon">{{ item.icon }}</span>
                            <span class="sidebar-menu-text">{{ item.label }}</span>
                        </a>
                    </li>
                {% endfor %}
            </ul>

            {# Section gestion #}
            {% if 'ROLE_MANAGER' in app.user.roles or 'ROLE_ADMIN' in app.user.roles %}
                <div class="sidebar-section">
                    <p class="sidebar-section-title">Gestion</p>

                    <a href="{{ path('manager_leaves') }}" class="sidebar-section-link">
                        <i class="fas fa-calendar-check"></i>
                        <span>Gérer les congés</span>
                    </a>

                    {% if 'ROLE_ADMIN' in app.user.roles %}
                        <a href="{{ path('admin_index') }}" class="sidebar-section-link">
                            <i class="fas fa-users-cog"></i>
                            <span>Gérer les utilisateurs</span>
                        </a>

                        <a href="{{ path('app_calendar') }}" class="sidebar-section-link">
                            <i class="fas fa-calendar-alt"></i>
                            <span>Voir Calendrier</span>
                        </a>
                    {% endif %}
                </div>
            {% endif %}

            {# Compte #}
            <div class="sidebar-section">
                <p class="sidebar-section-title">Compte</p>

                <a href="{{ path('user_profile') }}" class="sidebar-section-link">
                    <i class="fas fa-user-cog"></i>
                    <span>Paramètres du profil</span>
                </a>

                <form method="POST" action="{{ path('app_logout') }}" class="sidebar-logout-form" data-turbo="false">
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}">

                    <button type="submit" class="sidebar-logout-btn">
                        <i class="fas fa-sign-out-alt"></i>
                        <span>Déconnexion</span>
                    </button>
                </form>

            </div>
        </nav>
    </div>
</aside>
