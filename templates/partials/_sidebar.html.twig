<!-- Bouton menu mobile -->
<button id="mobile-menu-btn" class="mobile-menu-btn">
    <i class="fas fa-bars"></i>
</button>

<!-- Barre latérale -->
<aside id="sidebar" class="app-sidebar">
    <div class="sidebar-flex-container">
        {# Logo #}
        <div class="sidebar-logo">
            <div class="sidebar-logo-icon">
                <i class="fas fa-building"></i>
            </div>
            <div>
                <h1 class="sidebar-logo-title">Portail RH</h1>
                <p class="sidebar-logo-subtitle">Système de gestion</p>
            </div>
        </div>

        {# Infos utilisateur #}
        <div class="sidebar-user-info">
            <div class="sidebar-user-avatar">
                {{ app.user.firstName|slice(0,1)|upper }}{{ app.user.lastName|slice(0,1)|upper }}
            </div>
            <div>
                <h3 class="sidebar-user-name">{{ app.user.firstName }} {{ app.user.lastName }}</h3>
                <p class="sidebar-user-role">{{ role ?? 'Employé' }}</p>
                <p class="sidebar-user-dept">{{ app.user.department.value ?? 'N/A' }}</p>
            </div>
        </div>

        {# Navigation principale #}
        <nav class="sidebar-nav-main">
            {% set menu = [
                {'label': 'Tableau de bord', 'icon': '🏠', 'path': 'dashboard'},
                {'label': 'Demandes', 'icon': '📄', 'path': 'my_leaves'},
                {'label': 'Équipe', 'icon': '👥', 'path': 'team'}
            ] %}

            <ul class="sidebar-nav">
                {% for item in menu %}
                    <li>
                        <a href="{{ path(item.path) }}" class="sidebar-nav-item">
                            <span class="sidebar-nav-icon">{{ item.icon }}</span>
                            <span class="sidebar-nav-label">{{ item.label }}</span>
                        </a>
                    </li>
                {% endfor %}
            </ul>

            {# Section gestion #}
            {% if 'ROLE_MANAGER' in app.user.roles or 'ROLE_ADMIN' in app.user.roles %}
                <div class="sidebar-nav-section">
                    <p class="sidebar-nav-section-title">Gestion</p>

                    <a href="{{ path('manager_leaves') }}" class="sidebar-nav-item">
                        <i class="fas fa-calendar-check sidebar-nav-icon-fa"></i>
                        <span class="sidebar-nav-label">Gérer les congés</span>
                    </a>

                    {% if 'ROLE_ADMIN' in app.user.roles %}
                        <a href="{{ path('admin_index') }}" class="sidebar-nav-item">
                            <i class="fas fa-users-cog sidebar-nav-icon-fa"></i>
                            <span class="sidebar-nav-label">Gérer les utilisateurs</span>
                        </a>

                        <a href="{{ path('app_calendar') }}" class="sidebar-nav-item">
                            <i class="fas fa-calendar-alt sidebar-nav-icon-fa"></i>
                            <span class="sidebar-nav-label">Voir Calendrier</span>
                        </a>
                    {% endif %}
                </div>
            {% endif %}

            {# Compte #}
            <div class="sidebar-nav-section">
                <p class="sidebar-nav-section-title">Compte</p>

                <a href="{{ path('user_profile') }}" class="sidebar-nav-item">
                    <i class="fas fa-user-cog sidebar-nav-icon-fa"></i>
                    <span class="sidebar-nav-label">Paramètres du profil</span>
                </a>

                <form method="post" action="{{ path('app_logout') }}" data-turbo="false">
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}" >
                    <button type="submit" class="sidebar-logout">
                        <i class="fas fa-sign-out-alt sidebar-nav-icon-fa"></i>
                        <span class="sidebar-nav-label">Déconnexion</span>
                    </button>
                </form>
            </div>
        </nav>
    </div>
</aside>
