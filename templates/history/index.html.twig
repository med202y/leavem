{# templates/history.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Historique des notifications - {{ user.firstName }} {{ user.lastName }}{% endblock %}

{% block stylesheets %}
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <link href="{{ asset('css/sidebar-styles.css') }}" rel="stylesheet">
    <link href="{{ asset('css/history-styles.css') }}" rel="stylesheet">
{% endblock %}

{% block body %}
    {% include 'partials/_sidebar.html.twig' %}

    <!-- Contenu principal -->
    <main class="history-main-content">
        <div class="history-page-container">
            {# En-tête #}
            <div class="history-header">
                <h1 class="history-page-title">Historique des notifications</h1>
                <p class="history-date-text">{{ "now"|date("l, F j, Y") }}</p>
            </div>

            {# Tableau d'historique #}
            <div class="history-table-container">
                {% if notifications|length > 0 %}
                    <div class="history-table-wrapper">
                        <table class="history-table">
                            <thead class="history-table-header">
                            <tr>
                                <th>Date</th>
                                <th>Titre</th>
                                <th>Message</th>
                            </tr>
                            </thead>
                            <tbody class="history-table-body">
                            {% for notification in notifications %}
                                <tr>
                                    <td class="history-table-cell history-date-cell" data-label="Date">
                                        {{ notification.createdAt|date('d/m/Y H:i') }}
                                    </td>
                                    <td class="history-table-cell history-title-cell" data-label="Titre">
                                        {{ notification.title }}
                                    </td>
                                    <td class="history-table-cell history-message-cell" data-label="Message">
                                        {{ notification.message }}
                                    </td>
                                </tr>
                            {% endfor %}
                            </tbody>
                        </table>
                    </div>
                    {# Pagination si nécessaire #}
                {% else %}
                    <p class="history-empty-state">Aucune notification dans l'historique.</p>
                {% endif %}
            </div>
        </div>
    </main>
{% endblock %}

{% block javascripts %}
    <script>
        const menuBtn = document.getElementById('mobile-menu-btn');
        const sidebar = document.getElementById('sidebar');
        menuBtn?.addEventListener('click', () => sidebar?.classList.toggle('-translate-x-full'));
    </script>
{% endblock %}
