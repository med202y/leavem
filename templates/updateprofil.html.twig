{% extends 'base.html.twig' %}

{% block title %}Profil - {{ user.prenom }} {{ user.nom }}{% endblock %}

{% block stylesheets %}
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
{% endblock %}

{% block body %}
    <div class="flex min-h-screen bg-gray-100">
        <aside id="sidebar" class="fixed inset-y-0 left-0 z-50 w-72 bg-indigo-800 text-white shadow-md hidden md:block">
            <div class="h-full flex flex-col justify-between">
                <div>
                    <div class="p-6 text-2xl font-bold">
                        <i class="fas fa-user-circle mr-2"></i> Espace Utilisateur
                    </div>
                    <nav class="flex-1 p-4">
                        <ul class="space-y-1">
                            {% set menu = [
                                {'label': 'Tableau de bord', 'icon': '🏠', 'url': path('dashboard')},
                                {'label': 'Demander un congé', 'icon': '📄', 'url': '/leave/request'},
                                {'label': 'Historique des congés', 'icon': '📜', 'url': '/leave/history'},
                                {'label': 'Équipe', 'icon': '👥', 'url': '/team'}
                            ] %}

                            {% for item in menu %}
                                <li>
                                    <a href="{{ item.url }}" class="flex items-center gap-2 px-4 py-2 rounded hover:bg-white/10 transition-colors">
                                        <span class="text-lg">{{ item.icon }}</span>
                                        <span class="text-sm font-medium">{{ item.label }}</span>
                                    </a>
                                </li>
                            {% endfor %}
                        </ul>
                        <div class="pt-4">
                            <p class="text-xs uppercase tracking-wide px-4 mb-2 opacity-60">Compte</p>
                            <a href="#" class="flex items-center gap-3 px-4 py-3 rounded-lg hover:bg-white/5 text-white/80">
                                <i class="fas fa-user-cog w-5"></i>
                                <span>Paramètres du profil</span>
                            </a>
                            <a href="#" class="flex items-center gap-3 px-4 py-3 rounded-lg hover:bg-white/5 text-white/80">
                                <i class="fas fa-sign-out-alt w-5"></i>
                                <span>Déconnexion</span>
                            </a>
                        </div>
                    </nav>
                </div>
            </div>
        </aside>

        <main class="flex-1 p-6 md:ml-72">
            <div class="max-w-7xl mx-auto">
                <!-- Flash Messages -->
                {% for flash_error in app.flashes('error') %}
                    <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-4">
                        {{ flash_error }}
                    </div>
                {% endfor %}

                {% for flash_success in app.flashes('success') %}
                    <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded mb-4">
                        {{ flash_success }}
                    </div>
                {% endfor %}

                <div class="bg-white rounded-2xl p-6 shadow mb-6">
                    <h2 class="text-2xl font-bold text-indigo-700 mb-4">Mon profil</h2>

                    {{ form_start(form, {'attr': {'class': 'space-y-10'}}) }}
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <!-- Informations de contact -->
                        <div class="bg-gray-50 p-6 rounded-xl">
                            <h3 class="text-lg font-semibold mb-4">Détails de contact</h3>
                            <div class="grid grid-cols-1 gap-4">
                                <div>
                                    <label class="block text-sm font-medium mb-1">Prénom</label>
                                    <p class="font-semibold text-gray-700">{{ user.prenom}} </p>
                                </div>
                                <div>
                                    <label class="block text-sm font-medium mb-1">Nom</label>
                                    <p class="font-semibold text-gray-700">{{ user.nom}} </p>
                                </div>
                                <div>
                                    <label class="block text-sm font-medium mb-1">Departement</label>
                                    <p class="font-semibold text-gray-700">{{ user.Departement.value}} </p>
                                </div>
                                <div>
                                    <label class="block text-sm font-medium mb-1">Email</label>
                                    <p class="font-semibold text-gray-700">{{ user.email}} </p>
                                </div>
                            </div>
                        </div>

                        <!-- Changement de mot de passe -->
                        <div class="bg-gray-50 p-6 rounded-xl">
                            <h3 class="text-lg font-semibold mb-4">Changer le mot de passe</h3>
                            <div class="grid grid-cols-1 gap-4">
                                <div>
                                    <label class="block text-sm font-medium mb-1">Ancien mot de passe</label>
                                    <input type="password" name="old_password" class="w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:ring-indigo-500 focus:border-indigo-500">
                                </div>
                                <div>
                                    <label class="block text-sm font-medium mb-1">Nouveau mot de passe</label>
                                    <input type="password" name="new_password" class="w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:ring-indigo-500 focus:border-indigo-500">
                                </div>
                                <div>
                                    <label class="block text-sm font-medium mb-1">Confirmer mot de passe</label>
                                    <input type="password" name="confirm_password" class="w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:ring-indigo-500 focus:border-indigo-500">
                                </div>
                                <div class="text-xs text-gray-500">
                                    <p>• Le mot de passe doit contenir au moins 6 caractères</p>
                                    <p>• Laissez vide si vous ne souhaitez pas changer le mot de passe</p>
                                </div>
                            </div>
                        </div>
                    </div>

                    {# Hidden form fields that we don't want to display manually #}
                    <div style="display: none;">
                        {{ form_rest(form) }}
                    </div>

                    <div class="flex justify-end gap-4">
                        <button type="button" class="px-6 py-3 bg-red-600 text-white rounded-lg hover:bg-red-700">Supprimer le profil</button>
                        <button type="submit" class="px-6 py-3 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700">Mettre à jour</button>
                    </div>
                    {{ form_end(form) }}
                </div>
            </div>
        </main>
    </div>
{% endblock %}
