{% extends 'base.html.twig' %}

{% block title %}My Leave Requests{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
    <style>
        .edit-form { display: none; }
        .editing .details { display: none; }
        .editing .edit-form { display: block; }
    </style>
{% endblock %}

{% block body %}
    <div class="container mt-4">
        <h1 class="mb-4">My Leave Requests</h1>

        {% if conges is empty %}
            <div class="alert alert-info">No leave requests found</div>
        {% else %}
            <div class="list-group">
                {% for conge in conges %}
                    <div class="list-group-item" id="conge-{{ conge.id }}">
                        <div class="details">
                            <div class="d-flex justify-content-between">
                                <h5>{{ conge.typeConge.value }}</h5>
                                <span class="badge bg-{{ conge.statut.value == 'EN_ATTENTE' ? 'warning' : 'success' }}">
                                {{ conge.statut.value }}
                            </span>
                            </div>
                            <p class="mb-1">
                                <i class="bi bi-calendar-event"></i>
                                {{ conge.dateDebut|date('Y-m-d') }} to {{ conge.dateFin|date('Y-m-d') }}
                            </p>
                            <p class="mb-1">
                                <i class="bi bi-clock"></i>
                                Requested on: {{ conge.dateDemande|date('Y-m-d H:i') }}
                            </p>

                            {% if conge.statut.value == 'EN_ATTENTE' %}
                                <button class="btn btn-sm btn-primary mt-2 edit-btn" data-id="{{ conge.id }}">
                                    <i class="bi bi-pencil"></i> Edit
                                </button>
                            {% endif %}
                        </div>

                        <div class="edit-form">
                            <form class="update-form" data-id="{{ conge.id }}">
                                <div class="row g-2 mb-2">
                                    <div class="col-md">
                                        <label class="form-label">Start Date</label>
                                        <input type="date" name="date_debut"
                                               value="{{ conge.dateDebut|date('Y-m-d') }}"
                                               class="form-control" required>
                                    </div>
                                    <div class="col-md">
                                        <label class="form-label">End Date</label>
                                        <input type="date" name="date_fin"
                                               value="{{ conge.dateFin|date('Y-m-d') }}"
                                               class="form-control" required>
                                    </div>
                                </div>
                                <div class="d-flex gap-2">
                                    <button type="submit" class="btn btn-success btn-sm">
                                        <i class="bi bi-check-circle"></i> Update
                                    </button>
                                    <button type="button" class="btn btn-secondary btn-sm cancel-edit">
                                        Cancel
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% endif %}
    </div>
{% endblock %}

{% block javascripts %}
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        $(document).ready(function() {
            // Show edit form
            $('.edit-btn').click(function() {
                const id = $(this).data('id');
                $(`#conge-${id}`).addClass('editing');
            });

            // Cancel edit
            $('.cancel-edit').click(function() {
                $(this).closest('.list-group-item').removeClass('editing');
            });

            // Handle form submission
            $('.update-form').submit(function(e) {
                e.preventDefault();
                const id = $(this).data('id');
                const formData = $(this).serializeArray();
                const jsonData = {};

                formData.forEach(item => {
                    jsonData[item.name] = item.value;
                });

                $.ajax({
                    url: `/update-leave/${id}`,
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(jsonData),
                    success: function(response) {
                        if (response.status === 'success') {
                            // Update displayed dates
                            $(`#conge-${id} .details p:first`).html(
                                `<i class="bi bi-calendar-event"></i> ` +
                                response.newDateDebut + ' to ' + response.newDateFin
                            );

                            // Hide edit form
                            $(`#conge-${id}`).removeClass('editing');

                            alert('Leave request updated successfully!');
                        } else {
                            alert('Error: ' + response.message);
                        }
                    },
                    error: function() {
                        alert('An error occurred during update');
                    }
                });
            });
        });
    </script>
{% endblock %}
