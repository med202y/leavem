{# templates/conge/my_leaves.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Mes Demandes de Congé{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
    <style>
        .badge { min-width: 100px; }
        .conge-card { transition: transform 0.2s; }
        .conge-card:hover { transform: translateY(-5px); }
        .status-filter { cursor: pointer; }
        .status-filter.active { font-weight: bold; }
    </style>
{% endblock %}

{% block body %}
    <div class="container py-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1 class="d-flex align-items-center gap-2">
                <a href="{{ path('dashboard') }}" class="text-decoration-none text-dark" title="Retour">
                    <i class="bi bi-arrow-left" style="font-size: 1.5rem;"></i>
                </a>
                Mes Demandes de Congé
            </h1>

            <a href="{{ path('demande') }}" class="btn btn-primary">
                <i class="bi bi-plus-circle"></i> Nouvelle Demande
            </a>
        </div>

        {# Filtre par statut #}
        <div class="d-flex flex-wrap gap-2 mb-4">
            <span class="status-filter badge bg-light text-dark border active" data-status="all">Tous</span>
            {% for status in statuses %}
                <span class="status-filter badge bg-{{ statusColors[status] }}" data-status="{{ status }}">
                    {{ status|replace({'_': ' '})|title }}
                </span>
            {% endfor %}
        </div>

        {% if conges is empty %}
            <div class="alert alert-info">
                <i class="bi bi-info-circle"></i> Vous n'avez soumis aucune demande de congé pour le moment.
            </div>
        {% else %}
            <div class="row row-cols-1 row-cols-md-2 g-4">
                {% for conge in conges %}
                    <div class="col conge-card" data-status="{{ conge.statut.value }}">
                        <div class="card h-100 shadow-sm">
                            <div class="card-header d-flex justify-content-between align-items-center">
                                <span class="badge bg-{{ statusColors[conge.statut.value] }}">
                                    {{ conge.statut.value|replace({'_': ' '})|title }}
                                </span>
                                <span class="text-muted">
                                    #{{ conge.id }}
                                </span>
                            </div>

                            <div class="card-body">
                                <h5 class="card-title">
                                    <i class="bi bi-calendar2-event"></i>
                                    {{ conge.typeConge.value|title }}
                                </h5>

                                <div class="d-flex justify-content-between mb-2">
                                    <div>
                                        <small class="text-muted">Du</small>
                                        <div class="fw-bold">{{ conge.dateDebut|date('d M Y') }}</div>
                                    </div>
                                    <div class="text-center">
                                        <i class="bi bi-arrow-right"></i>
                                    </div>
                                    <div>
                                        <small class="text-muted">Au</small>
                                        <div class="fw-bold">{{ conge.dateFin|date('d M Y') }}</div>
                                    </div>
                                </div>

                                <div class="mb-2">
                                    <small class="text-muted">Durée</small>
                                    <div class="fw-bold">
                                        {{ conge.dateFin.diff(conge.dateDebut).days + 1 }} jours
                                    </div>
                                </div>

                                {% if conge.motif %}
                                    <div class="mb-2">
                                        <small class="text-muted">Motif</small>
                                        <div>{{ conge.motif }}</div>
                                    </div>
                                {% endif %}

                                <div class="mt-3">
                                    <small class="text-muted">Demandé le</small>
                                    <div>{{ conge.dateDemande|date('d M Y H:i') }}</div>
                                </div>

                                {% if conge.dateTraitement %}
                                    <div>
                                        <small class="text-muted">Traité le</small>
                                        <div>{{ conge.dateTraitement|date('d M Y H:i') }}</div>
                                    </div>
                                {% endif %}
                            </div>

                            <div class="card-footer bg-transparent d-flex justify-content-between align-items-center">
                                <div>
                                    {% if conge.traitePar %}
                                        <small class="text-muted">Traité par : {{ conge.traitePar }}</small>
                                    {% endif %}
                                </div>
                                <div>
                                    {% if conge.statut.value == 'en_attente' %}
                                        <button class="btn btn-sm btn-outline-secondary me-2 edit-btn"
                                                data-id="{{ conge.id }}"
                                                data-start="{{ conge.dateDebut|date('Y-m-d') }}"
                                                data-end="{{ conge.dateFin|date('Y-m-d') }}">
                                            Modifier
                                        </button>
                                        <button class="btn btn-sm btn-outline-danger cancel-btn" data-id="{{ conge.id }}">
                                            Annuler
                                        </button>
                                    {% endif %}
                                </div>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% endif %}
    </div>

    <!-- Edit Leave Modal -->
    <div class="modal fade" id="editLeaveModal" tabindex="-1" aria-labelledby="editLeaveModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="editLeaveModalLabel">
                        <i class="bi bi-pencil-square"></i> Modifier la demande de congé
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <form id="editLeaveForm">
                        <div class="mb-3">
                            <label for="editStartDate" class="form-label">Date de début</label>
                            <input type="date" class="form-control" id="editStartDate" required>
                        </div>
                        <div class="mb-3">
                            <label for="editEndDate" class="form-label">Date de fin</label>
                            <input type="date" class="form-control" id="editEndDate" required>
                        </div>
                        <div class="alert alert-info">
                            <i class="bi bi-info-circle"></i> Seules les demandes en attente peuvent être modifiées.
                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        <i class="bi bi-x-circle"></i> Annuler
                    </button>
                    <button type="button" class="btn btn-primary" id="saveChangesBtn">
                        <i class="bi bi-check-circle"></i> Enregistrer les modifications
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Cancel Leave Modal -->
    <div class="modal fade" id="cancelLeaveModal" tabindex="-1" aria-labelledby="cancelLeaveModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title" id="cancelLeaveModalLabel">
                        <i class="bi bi-exclamation-triangle"></i> Confirmer l'annulation
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="d-flex align-items-center mb-3">
                        <i class="bi bi-question-circle-fill text-warning me-3" style="font-size: 2rem;"></i>
                        <div>
                            <h6 class="mb-1">Êtes-vous sûr de vouloir annuler cette demande de congé ?</h6>
                            <small class="text-muted">Cette action ne peut pas être annulée.</small>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        <i class="bi bi-x-circle"></i> Non, garder la demande
                    </button>
                    <button type="button" class="btn btn-danger" id="confirmCancelBtn">
                        <i class="bi bi-trash"></i> Oui, annuler la demande
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Success/Error Alert Modal -->
    <div class="modal fade" id="alertModal" tabindex="-1" aria-labelledby="alertModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-sm">
            <div class="modal-content">
                <div class="modal-header" id="alertModalHeader">
                    <h5 class="modal-title" id="alertModalLabel"></h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body text-center">
                    <div id="alertModalIcon" class="mb-3"></div>
                    <p id="alertModalMessage"></p>
                </div>
                <div class="modal-footer justify-content-center">
                    <button type="button" class="btn btn-primary" data-bs-dismiss="modal">OK</button>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            let currentLeaveId = null;

            // Check if bootstrap is loaded
            if (typeof bootstrap === 'undefined') {
                console.error('Bootstrap is not loaded');
                return;
            }

            // Initialize modals
            const editModalEl = document.getElementById('editLeaveModal');
            const cancelModalEl = document.getElementById('cancelLeaveModal');
            const alertModalEl = document.getElementById('alertModal');

            const editModal = new bootstrap.Modal(editModalEl);
            const cancelModal = new bootstrap.Modal(cancelModalEl);
            const alertModal = new bootstrap.Modal(alertModalEl);

            // Filtrage par statut
            const statusFilters = document.querySelectorAll('.status-filter');

            statusFilters.forEach(filter => {
                filter.addEventListener('click', function () {
                    const status = this.dataset.status;

                    statusFilters.forEach(f => f.classList.remove('active', 'border'));
                    this.classList.add('active');
                    if (status !== 'all') this.classList.add('border');

                    document.querySelectorAll('.conge-card').forEach(card => {
                        card.style.display = (status === 'all' || card.dataset.status === status) ? 'block' : 'none';
                    });
                });
            });

            // Show alert modal
            function showAlert(title, message, type = 'success') {
                const header = document.getElementById('alertModalHeader');
                const titleEl = document.getElementById('alertModalLabel');
                const iconEl = document.getElementById('alertModalIcon');
                const messageEl = document.getElementById('alertModalMessage');

                // Set header color and icon based on type
                if (type === 'success') {
                    header.className = 'modal-header bg-success text-white';
                    iconEl.innerHTML = '<i class="bi bi-check-circle-fill text-success" style="font-size: 3rem;"></i>';
                } else {
                    header.className = 'modal-header bg-danger text-white';
                    iconEl.innerHTML = '<i class="bi bi-exclamation-triangle-fill text-danger" style="font-size: 3rem;"></i>';
                }

                titleEl.textContent = title;
                messageEl.textContent = message;
                alertModal.show();
            }

            // Gestion du bouton Modifier
            document.querySelectorAll('.edit-btn').forEach(button => {
                button.addEventListener('click', function () {
                    currentLeaveId = this.dataset.id;
                    const startDate = this.dataset.start;
                    const endDate = this.dataset.end;

                    // Pre-fill the form
                    document.getElementById('editStartDate').value = startDate;
                    document.getElementById('editEndDate').value = endDate;

                    editModal.show();
                });
            });

            // Handle edit form submission
            const saveChangesBtn = document.getElementById('saveChangesBtn');
            if (saveChangesBtn) {
                saveChangesBtn.addEventListener('click', function () {
                    const startDateEl = document.getElementById('editStartDate');
                    const endDateEl = document.getElementById('editEndDate');

                    if (!startDateEl || !endDateEl) {
                        showAlert('Erreur', 'Éléments de formulaire introuvables', 'error');
                        return;
                    }

                    const startDate = startDateEl.value;
                    const endDate = endDateEl.value;

                    if (!startDate || !endDate) {
                        showAlert('Erreur', 'Veuillez remplir toutes les dates', 'error');
                        return;
                    }

                    if (new Date(startDate) > new Date(endDate)) {
                        showAlert('Erreur', 'La date de début doit être antérieure à la date de fin', 'error');
                        return;
                    }

                    // Show loading state
                    this.disabled = true;
                    this.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Enregistrement...';

                    fetch(`/edit-conge/${currentLeaveId}`, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'X-Requested-With': 'XMLHttpRequest',
                        },
                        body: JSON.stringify({ dateDebut: startDate, dateFin: endDate }),
                    })
                        .then(res => res.json())
                        .then(data => {
                            editModal.hide();

                            if (data.success) {
                                showAlert('Succès', 'Congé mis à jour avec succès', 'success');
                                setTimeout(() => location.reload(), 2000);
                            } else {
                                showAlert('Erreur', data.message || 'Une erreur est survenue', 'error');
                            }
                        })
                        .catch(error => {
                            editModal.hide();
                            showAlert('Erreur', 'Erreur de connexion', 'error');
                        })
                        .finally(() => {
                            // Reset button state
                            this.disabled = false;
                            this.innerHTML = '<i class="bi bi-check-circle"></i> Enregistrer les modifications';
                        });
                });
            }

            // Gestion du bouton Annuler
            document.querySelectorAll('.cancel-btn').forEach(button => {
                button.addEventListener('click', function () {
                    currentLeaveId = this.dataset.id;
                    cancelModal.show();
                });
            });

            // Handle cancel confirmation
            const confirmCancelBtn = document.getElementById('confirmCancelBtn');
            if (confirmCancelBtn) {
                confirmCancelBtn.addEventListener('click', function () {
                    // Show loading state
                    this.disabled = true;
                    this.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Annulation...';

                    fetch(`/cancel-conge/${currentLeaveId}`, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'X-Requested-With': 'XMLHttpRequest',
                        }
                    })
                        .then(res => res.json())
                        .then(data => {
                            cancelModal.hide();

                            if (data.success) {
                                showAlert('Succès', 'Demande de congé annulée avec succès', 'success');
                                setTimeout(() => location.reload(), 2000);
                            } else {
                                showAlert('Erreur', data.message || 'Une erreur est survenue', 'error');
                            }
                        })
                        .catch(error => {
                            cancelModal.hide();
                            showAlert('Erreur', 'Erreur de connexion', 'error');
                        })
                        .finally(() => {
                            // Reset button state
                            this.disabled = false;
                            this.innerHTML = '<i class="bi bi-trash"></i> Oui, annuler la demande';
                        });
                });
            }

            // Reset modal forms when closed
            if (editModalEl) {
                editModalEl.addEventListener('hidden.bs.modal', function () {
                    const form = document.getElementById('editLeaveForm');
                    if (form) form.reset();
                    currentLeaveId = null;
                });
            }

            if (cancelModalEl) {
                cancelModalEl.addEventListener('hidden.bs.modal', function () {
                    currentLeaveId = null;
                });
            }
        });
    </script>
{% endblock %}
