{# templates/conge/my_leaves.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}My Leave Requests{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
    <style>
        .badge { min-width: 100px; }
        .conge-card { transition: transform 0.2s; }
        .conge-card:hover { transform: translateY(-5px); }
        .status-filter { cursor: pointer; }
        .status-filter.active { font-weight: bold; }
    </style>
{% endblock %}

{% block body %}
    <div class="container py-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1 class="d-flex align-items-center gap-2">
                <a href="{{ path('dashboard') }}" class="text-decoration-none text-dark" title="Go back">
                    <i class="bi bi-arrow-left" style="font-size: 1.5rem;"></i>
                </a>
                My Leave Requests
            </h1>

            <a href="{{ path('demande') }}" class="btn btn-primary">
                <i class="bi bi-plus-circle"></i> New Leave Request
            </a>
        </div>

        {# Status filter #}
        <div class="d-flex flex-wrap gap-2 mb-4">
            <span class="status-filter badge bg-light text-dark border active" data-status="all">All</span>
            {% for status in statuses %}
                <span class="status-filter badge bg-{{ statusColors[status] }}" data-status="{{ status }}">
                    {{ status }}
                </span>
            {% endfor %}
        </div>

        {% if conges is empty %}
            <div class="alert alert-info">
                <i class="bi bi-info-circle"></i> You haven't submitted any leave requests yet.
            </div>
        {% else %}
            <div class="row row-cols-1 row-cols-md-2 g-4">
                {% for conge in conges %}
                    <div class="col conge-card" data-status="{{ conge.statut.value }}">
                        <div class="card h-100 shadow-sm">
                            <div class="card-header d-flex justify-content-between align-items-center">
                                <span class="badge bg-{{ statusColors[conge.statut.value] }}">
                                    {{ conge.statut.value }}
                                </span>
                                <span class="text-muted">
                                    #{{ conge.id }}
                                </span>
                            </div>

                            <div class="card-body">
                                <h5 class="card-title">
                                    <i class="bi bi-calendar2-event"></i>
                                    {{ conge.typeConge.value|title }}
                                </h5>

                                <div class="d-flex justify-content-between mb-2">
                                    <div>
                                        <small class="text-muted">From</small>
                                        <div class="fw-bold">{{ conge.dateDebut|date('M d, Y') }}</div>
                                    </div>
                                    <div class="text-center">
                                        <i class="bi bi-arrow-right"></i>
                                    </div>
                                    <div>
                                        <small class="text-muted">To</small>
                                        <div class="fw-bold">{{ conge.dateFin|date('M d, Y') }}</div>
                                    </div>
                                </div>

                                <div class="mb-2">
                                    <small class="text-muted">Duration</small>
                                    <div class="fw-bold">
                                        {{ conge.dateFin.diff(conge.dateDebut).days + 1 }} days
                                    </div>
                                </div>

                                {% if conge.motif %}
                                    <div class="mb-2">
                                        <small class="text-muted">Reason</small>
                                        <div>{{ conge.motif }}</div>
                                    </div>
                                {% endif %}

                                <div class="mt-3">
                                    <small class="text-muted">Requested on</small>
                                    <div>{{ conge.dateDemande|date('M d, Y H:i') }}</div>
                                </div>

                                {% if conge.dateTraitement %}
                                    <div>
                                        <small class="text-muted">Processed on</small>
                                        <div>{{ conge.dateTraitement|date('M d, Y H:i') }}</div>
                                    </div>
                                {% endif %}
                            </div>

                            <div class="card-footer bg-transparent d-flex justify-content-between align-items-center">
                                <div>
                                    {% if conge.traitePar %}
                                        <small class="text-muted">Processed by: {{ conge.traitePar }}</small>
                                    {% endif %}
                                </div>
                                <div>
                                    <button class="btn btn-sm btn-outline-secondary me-2 edit-btn" data-id="{{ conge.id }}">Edit</button>
                                    <button class="btn btn-sm btn-outline-danger cancel-btn" data-id="{{ conge.id }}">Cancel</button>
                                </div>
                            </div>


                        </div>
                    </div>
                {% endfor %}
            </div>
        {% endif %}
    </div>
{% endblock %}

{% block javascripts %}
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Status filtering
            const statusFilters = document.querySelectorAll('.status-filter');

            statusFilters.forEach(filter => {
                filter.addEventListener('click', function () {
                    const status = this.dataset.status;

                    statusFilters.forEach(f => f.classList.remove('active', 'border'));
                    this.classList.add('active');
                    if (status !== 'all') this.classList.add('border');

                    document.querySelectorAll('.conge-card').forEach(card => {
                        card.style.display = (status === 'all' || card.dataset.status === status) ? 'block' : 'none';
                    });
                });
            });

            // Handle Edit button click
            document.querySelectorAll('.edit-btn').forEach(button => {
                button.addEventListener('click', function () {
                    const id = this.dataset.id;
                    const newStart = prompt("Enter new start date (YYYY-MM-DD):");
                    const newEnd = prompt("Enter new end date (YYYY-MM-DD):");

                    if (newStart && newEnd) {
                        fetch(`/edit-conge/${id}`, {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json',
                                'X-Requested-With': 'XMLHttpRequest',
                            },
                            body: JSON.stringify({ dateDebut: newStart, dateFin: newEnd }),
                        })
                            .then(res => res.json())
                            .then(data => {
                                if (data.success) {
                                    alert('Leave updated successfully');
                                    location.reload();
                                } else {
                                    alert('Error: ' + data.message);
                                }
                            });
                    }
                });
            });

            // Handle Cancel button click
            document.querySelectorAll('.cancel-btn').forEach(button => {
                button.addEventListener('click', function () {
                    const id = this.dataset.id;

                    if (confirm("Are you sure you want to cancel this leave request?")) {
                        fetch(`/cancel-conge/${id}`, {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json',
                                'X-Requested-With': 'XMLHttpRequest',
                            }
                        })
                            .then(res => res.json())
                            .then(data => {
                                if (data.success) {
                                    alert('Leave cancelled successfully');
                                    location.reload();
                                } else {
                                    alert('Error: ' + data.message);
                                }
                            });
                    }
                });
            });
        });
    </script>
{% endblock %}
